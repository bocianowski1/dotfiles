#!/usr/bin/env bash
# Claude Code sidebar for tmux. Every window gets its own sidebar pane on the left, so
# switching windows never resizes anything; they all show the same tree.
#   claude-sidebar toggle        turn sidebars on (hides the status bar) or off
#   claude-sidebar add <window>  give <window> a sidebar if sidebars are on (tmux hook)
#   claude-sidebar opened <window> record when <window> was switched to (tmux hook)
#   claude-sidebar refresh       redraw every sidebar now (tmux and Claude hooks)
#   claude-sidebar mark [window] mark/unmark a window (green in the sidebar; prefix m)
#   claude-sidebar todo-*        add, tick off and edit todos (sidebar keys a/e, clicks, prefix T)
#   claude-sidebar focus-in      refetch issues after one was opened from the sidebar (tmux hook)
#   claude-sidebar focus [issues] keyboard into the sidebar (prefix e) or its issues (prefix i):
#                                j/k ↑/↓ move, Enter acts like a click, / filters issues, Esc back
#   claude-sidebar render        draw loop running inside a sidebar pane
# Each window is a group; each Claude pane in it is an item with a state dot on the right.
WIDTH=34
self=$(readlink -f "$0")
US=$'\x1f' # field separator: not whitespace, so empty fields survive read
FMT="#{window_id}${US}#{pane_id}${US}#{window_index}${US}#{window_name}${US}#{window_active}${US}#{pane_active}${US}#{@claude_state}${US}#{pane_title}${US}#{pane_current_path}${US}#{pane_current_command}${US}#{@claude_sidebar}${US}#{@last_opened}${US}#{@claude_marked}${US}#{@claude_replied}"

sidebar_panes() {
  tmux list-panes -a -F '#{pane_id} #{@claude_sidebar}' | awk '$2 == "1" { print $1 }'
}

add() {
  local window=$1
  # The issue image viewer gets the whole window
  [ "$(tmux display -p -t "$window" '#{window_name}')" = issue-image ] && return
  tmux list-panes -t "$window" -F '#{@claude_sidebar}' | grep -qx 1 && return
  tmux split-window -d -f -h -b -l "$WIDTH" -t "$window" "'$self' render"
}

CALENDAR_URL_FILE=~/.config/claude-sidebar/calendar-url
CALENDAR_CACHE=~/.cache/claude-sidebar/calendar.tsv
CALENDAR_MAX=5 # meetings shown

# Calendar lines for the bottom of the sidebar, into the array cal_lines (and the Teams
# join link for each line into cal_urls). Reads the cache written by claude-calendar.
calendar_lines() {
  local width=$1 now=$2 ESC=$'\e'
  local RESET="$ESC[0m" BOLD="$ESC[1m" DIM="$ESC[38;5;245m"
  cal_lines=() cal_urls=()
  [ -f "$CALENDAR_URL_FILE" ] || return
  local today tomorrow wday k d start end title url
  printf -v today '%(%F)T' "$now"
  printf -v tomorrow '%(%F)T' $((now + 86400))
  # The rest of this week (to Sunday) after tomorrow, by date; noon steps are safe across DST
  local -A later_day=()
  local midnight hms
  printf -v hms '%(%H %M %S %u)T' "$now"
  read -r k d start wday <<<"$hms"
  midnight=$((now - 10#$k * 3600 - 10#$d * 60 - 10#$start))
  for ((k = 2; k <= 7 - wday; k++)); do
    printf -v d '%(%F)T' $((midnight + k * 86400 + 43200))
    later_day[$d]=1
  done

  # Meetings not over yet: today's and tomorrow's (CALENDAR_MAX in all), and the first one
  # after that this week
  local -a today_rows=() tomorrow_rows=()
  local next_row= day
  if [ -s "$CALENDAR_CACHE" ]; then
    while IFS=$'\t' read -r start end title url; do
      [ "$end" -gt "$now" ] || continue
      printf -v day '%(%F)T' "$start"
      if [ "$day" = "$today" ] || [ "$day" = "$tomorrow" ]; then
        [ $((${#today_rows[@]} + ${#tomorrow_rows[@]})) -lt "$CALENDAR_MAX" ] || continue
        if [ "$day" = "$today" ]; then today_rows+=("$start"$'\t'"$end"$'\t'"$title"$'\t'"$url")
        else tomorrow_rows+=("$start"$'\t'"$end"$'\t'"$title"$'\t'"$url"); fi
      elif [ -z "$next_row" ] && [ -n "${later_day[$day]:-}" ]; then
        next_row="$start"$'\t'"$end"$'\t'"$title"$'\t'"$url"
      fi
    done <"$CALENDAR_CACHE"
  fi

  local r
  if [ ${#today_rows[@]} -gt 0 ]; then
    cal_lines+=("${BOLD} Today${RESET}") cal_urls+=("")
    for r in "${today_rows[@]}"; do calendar_meeting "$r"; done
  elif [ ${#tomorrow_rows[@]} -gt 0 ] || [ -n "$next_row" ]; then
    cal_lines+=("${DIM} No meetings today${RESET}") cal_urls+=("")
  else
    cal_lines+=("${DIM} No meetings this week${RESET}") cal_urls+=("")
    return
  fi
  if [ ${#tomorrow_rows[@]} -gt 0 ]; then
    cal_lines+=("" "${BOLD} Tomorrow${RESET}") cal_urls+=("" "")
    for r in "${tomorrow_rows[@]}"; do calendar_meeting "$r"; done
  elif [ ${#today_rows[@]} -eq 0 ]; then
    # Nothing today or tomorrow: the next meeting this week, under its day
    local label
    printf -v label '%(%A %d.%m)T' "${next_row%%$'\t'*}"
    cal_lines+=("" "${BOLD} ${label}${RESET}") cal_urls+=("" "")
    calendar_meeting "$next_row"
  fi
}
# One meeting line (calendar_lines' locals): "now" while it runs, "in 12m" within the hour
# (orange from 10 minutes before)
calendar_meeting() { # <cache row>
  local start end title url tag= tagc=$DIM mins hhmm max=$((width - 16)) line
  IFS=$'\t' read -r start end title url <<<"$1"
  mins=$(((start - now + 59) / 60))
  if [ "$start" -le "$now" ]; then tag=now tagc="$ESC[38;5;114m"
  elif [ "$mins" -le 60 ]; then tag="in ${mins}m"; [ "$mins" -le 10 ] && tagc="$ESC[1;38;5;214m"
  fi
  printf -v hhmm '%(%H:%M)T' "$start"
  [ ${#title} -gt "$max" ] && title="${title:0:max-1}…"
  printf -v line '  %s%s%s %-*s %s%6s%s' "$DIM" "$hhmm" "$RESET" "$max" "$title" "$tagc" "$tag" "$RESET"
  cal_lines+=("$line") cal_urls+=("$url")
}

TODO_FILE=~/.config/claude-sidebar/todo.md
TODO_ROWS=5 # items visible at once; the mouse wheel (or j/k) scrolls through the rest

# Open todo items ("- [ ] ..." lines of TODO_FILE): all of them into todo_all / todo_all_refs
# (the file line number of each, so a click can tick that line off), and the visible window
# from todo_offset, with the header, into todo_lines / todo_refs
todo_lines() {
  local width=$1 ESC=$'\e'
  local RESET="$ESC[0m" BOLD="$ESC[1m" DIM="$ESC[38;5;245m"
  todo_lines=() todo_refs=() todo_all=() todo_all_refs=()

  local lineno=0 text max=$((width - 5))
  if [ -f "$TODO_FILE" ]; then
    while IFS= read -r text || [ -n "$text" ]; do
      lineno=$((lineno + 1))
      [[ $text =~ ^[[:space:]]*-\ \[\ \]\  ]] || continue
      text=${text#*- \[ \] }
      [ ${#text} -gt "$max" ] && text="${text:0:max-1}…"
      todo_all+=("  ${DIM}○${RESET} $text") todo_all_refs+=("$lineno")
    done <"$TODO_FILE"
  fi
  local total=${#todo_all[@]}
  # Keep the keyboard selection in view when it moves onto a todo
  if [ "$nav" = 1 ] && [ "$nav_target" != "$nav_seen" ] && [[ $nav_target == todo:* ]]; then
    local i
    for i in "${!todo_all_refs[@]}"; do
      [ "todo:${todo_all_refs[i]}" = "$nav_target" ] || continue
      [ "$i" -ge "$todo_offset" ] || todo_offset=$i
      [ "$i" -lt $((todo_offset + TODO_ROWS)) ] || todo_offset=$((i - TODO_ROWS + 1))
    done
  fi
  local last=$((total - TODO_ROWS))
  [ "$last" -ge 0 ] || last=0
  [ "$todo_offset" -le "$last" ] || todo_offset=$last
  [ "$todo_offset" -ge 0 ] || todo_offset=0

  local head title=" Todo" more
  [ "$total" -gt 0 ] && title+=" ($total)"
  scroll_marks "$todo_offset" $((total - todo_offset - TODO_ROWS))
  local hint="a add · e edit" room=$((width - ${#title} - ${#more} - 2))
  [ "$room" -ge ${#hint} ] || hint=
  printf -v head '%s%s%s %s%*s%s' "$BOLD" "$title" "$RESET$DIM" "$more" $((room + 1)) "$hint" "$RESET"
  todo_lines+=("$head") todo_refs+=(edit)
  todo_lines+=("${todo_all[@]:todo_offset:TODO_ROWS}") todo_refs+=("${todo_all_refs[@]:todo_offset:TODO_ROWS}")
  [ "$total" -gt 0 ] || { todo_lines+=("${DIM}  Nothing to do${RESET}") todo_refs+=(""); }
}

# "↑2 ↓5" into more: how many rows a scrolled list hides above and below (empty when none)
scroll_marks() { # <above> <below>
  more=
  [ "$1" -gt 0 ] && more="↑$1"
  [ "$2" -gt 0 ] && more+="${more:+ }↓$2"
  return 0
}

# Tick off line <n> of TODO_FILE, only if it is still an open item (the file may have
# changed). In bash, no sed: a click on a todo redraws straight after this.
todo_tick() { # <line number>
  local -a todo_file
  local i=$(($1 - 1)) re='^([[:space:]]*)- \[ \] (.*)$'
  mapfile -t todo_file 2>/dev/null <"$TODO_FILE" || return
  [[ ${todo_file[i]:-} =~ $re ]] || return
  todo_file[i]="${BASH_REMATCH[1]}- [x] ${BASH_REMATCH[2]}"
  printf '%s\n' "${todo_file[@]}" >"$TODO_FILE"
}

# Redraw every sidebar but <pane> (that one redraws itself): one tmux call for them all
refresh_others() { # [pane]
  local p args=()
  for p in $(sidebar_panes); do
    [ "$p" = "${1:-}" ] || args+=(send-keys -t "$p" C-r \;)
  done
  [ ${#args[@]} -gt 0 ] && tmux "${args[@]:0:${#args[@]}-1}"
}

# Refresh the calendar cache in the background every 5 minutes, or now with "force"
calendar_fetch() {
  [ -f "$CALENDAR_URL_FILE" ] || return
  local age=999999
  [ -f "$CALENDAR_CACHE" ] && age=$((EPOCHSECONDS - $(stat -c %Y "$CALENDAR_CACHE")))
  [ "${1:-}" = force ] || [ "$age" -ge 300 ] || return
  mkdir -p "${CALENDAR_CACHE%/*}"
  { flock -n "${CALENDAR_CACHE%/*}/fetch.lock" "${self%/*}/claude-calendar" && "$self" refresh; } </dev/null >/dev/null 2>&1 &
}

ISSUES_CACHE=~/.cache/claude-sidebar/issues.tsv
ISSUES_ROWS=8 # issues visible at most; the mouse wheel scrolls through the rest
issue_rows_vis=$ISSUES_ROWS # fewer on a short pane (render works it out every frame)

# The issues to show, into issue_rows (cache rows) and issue_total: all of claude-issues'
# cache, or those matching issue_filter (case-insensitive, on repo#number and title)
load_issue_rows() {
  issue_rows=()
  [ -f "$ISSUES_CACHE" ] || { issue_total=0; return; }
  if [ -z "$issue_filter" ]; then
    mapfile -t issue_rows <"$ISSUES_CACHE"
  else
    local row repo num mine title url
    while IFS= read -r row; do
      IFS=$'\t' read -r repo num mine title url <<<"$row"
      [[ "${repo,,}#$num ${title,,}" == *"${issue_filter,,}"* ]] && issue_rows+=("$row")
    done <"$ISSUES_CACHE"
  fi
  issue_total=${#issue_rows[@]}
  [ "$issue_sel" -lt "$issue_total" ] || issue_sel=$((issue_total > 0 ? issue_total - 1 : 0))
  local last=$((issue_total - issue_rows_vis))
  [ "$last" -ge 0 ] || last=0
  [ "$issue_offset" -le "$last" ] || issue_offset=$last
}
issue_url_at() { local f; IFS=$'\t' read -r f f f f issue_url <<<"${issue_rows[$1]:-}"; } # <index> → issue_url
issue_index_of() { # <url>: its index in issue_rows, or nothing
  local i
  for i in "${!issue_rows[@]}"; do [[ ${issue_rows[i]} == *$'\t'"$1" ]] && { echo "$i"; return; }; done
}

# The visible window of issue_rows into issue_lines / issue_urls, from issue_offset; with a
# filter line under the header while you type one (or one is set)
issue_lines() {
  local width=$1 ESC=$'\e'
  local RESET="$ESC[0m" BOLD="$ESC[1m" DIM="$ESC[38;5;245m" MINE="$ESC[38;5;214m" KEYC="$ESC[38;5;215m"
  local offset=$issue_offset
  issue_lines=() issue_urls=()
  command -v gh >/dev/null || return
  local range=
  [ "$issue_total" -gt "$issue_rows_vis" ] && range="$((offset + 1))–$((offset + issue_rows_vis > issue_total ? issue_total : offset + issue_rows_vis)) of $issue_total ↕"
  [ "$issue_total" -gt 0 ] && [ -z "$range" ] && range="$issue_total open"
  [ -n "$issue_filter" ] && [ "$issue_total" -le "$issue_rows_vis" ] && range="$issue_total match"
  local head
  printf -v head '%s Issues%s%*s%s' "$BOLD" "$RESET$DIM" $((width - 8)) "$range" "$RESET"
  issue_lines+=("$head") issue_urls+=("")
  if [ "$filter_typing" = 1 ] || [ -n "$issue_filter" ]; then
    local cursor=
    [ "$filter_typing" = 1 ] && cursor="${KEYC}▏${RESET}"
    issue_lines+=("  ${KEYC}/${RESET} ${issue_filter}${cursor}") issue_urls+=(filter)
  fi
  if [ "$issue_total" = 0 ]; then
    if [ -n "$issue_filter" ]; then issue_lines+=("${DIM}  No issue matches${RESET}"); else issue_lines+=("${DIM}  No open issues${RESET}"); fi
    issue_urls+=("")
    return
  fi

  local i repo num mine title url ref max
  for ((i = offset; i < offset + issue_rows_vis && i < issue_total; i++)); do
    IFS=$'\t' read -r repo num mine title url <<<"${issue_rows[i]}"
    [ ${#repo} -gt 12 ] && repo="${repo:0:11}…"
    ref="$repo#$num"
    max=$((width - ${#ref} - 5))
    [ ${#title} -gt "$max" ] && title="${title:0:max-1}…"
    local dot=' '
    [ "$mine" = 1 ] && dot="${MINE}●${RESET}"
    issue_lines+=("  $dot ${DIM}${ref}${RESET} $title") issue_urls+=("$url")
  done
  local issue_ttl_minutes
  issue_ttl
  issue_lines+=("${DIM}  cache ${issue_ttl_minutes}m · click to change${RESET}") issue_urls+=(ttl)
}

# Refresh the issues cache in the background every 5 minutes, or now with "force"
# (one fetch at a time); the sidebars redraw as soon as it lands
issues_fetch() {
  command -v gh >/dev/null || return
  local age=999999
  [ -f "$ISSUES_CACHE" ] && age=$((EPOCHSECONDS - $(stat -c %Y "$ISSUES_CACHE")))
  [ "${1:-}" = force ] || [ "$age" -ge 300 ] || return
  mkdir -p "${ISSUES_CACHE%/*}"
  { flock -n "${ISSUES_CACHE%/*}/issues.lock" "${self%/*}/claude-issues" && "$self" refresh; } </dev/null >/dev/null 2>&1 &
}

# Keyboard mode (prefix e, prefix i). These work on render()'s locals. The selection,
# nav_target, is a click target ("@window", "%pane", "issue:<url>", "todo:<line>", ...), so
# Enter does exactly what a click on that row does; nav_order lists the targets on screen.
issue_scroll() { # $1 rows; keeps a selected issue inside the visible window
  local last=$((issue_total - issue_rows_vis))
  [ "$last" -ge 0 ] || last=0
  issue_offset=$((issue_offset + $1))
  [ "$issue_offset" -le "$last" ] || issue_offset=$last
  [ "$issue_offset" -ge 0 ] || issue_offset=0
  if [ "$nav" = 1 ] && [[ $nav_target == issue:* ]]; then
    [ "$issue_sel" -ge "$issue_offset" ] || issue_sel=$issue_offset
    [ "$issue_sel" -lt $((issue_offset + issue_rows_vis)) ] || issue_sel=$((issue_offset + issue_rows_vis - 1))
    issue_url_at "$issue_sel"
    nav_target="issue:$issue_url"
  fi
}
issue_move() { # $1 issues; scrolls to keep the selection visible, prefetches the selection
  [ "$issue_total" -gt 0 ] || return
  issue_sel=$((issue_sel + $1))
  [ "$issue_sel" -lt "$issue_total" ] || issue_sel=$((issue_total - 1))
  [ "$issue_sel" -ge 0 ] || issue_sel=0
  [ "$issue_sel" -ge "$issue_offset" ] || issue_offset=$issue_sel
  [ "$issue_sel" -lt $((issue_offset + issue_rows_vis)) ] || issue_offset=$((issue_sel - issue_rows_vis + 1))
  issue_prefetch_selected
}
nav_select_issue() { # <index>: select that issue (scrolled into view, prefetched)
  issue_sel=$1
  issue_move 0
  issue_url_at "$issue_sel"
  nav_target="issue:$issue_url"
}
nav_move() { # <1|-1>: the next/previous row you can act on
  local d=$1 i at=-1
  # Within the issues, step through the whole (filtered) list, scrolling as needed
  if [[ $nav_target == issue:* ]] && [ $((issue_sel + d)) -ge 0 ] && [ $((issue_sel + d)) -lt "$issue_total" ]; then
    nav_select_issue $((issue_sel + d))
    return
  fi
  for i in "${!nav_order[@]}"; do [ "${nav_order[i]}" = "$nav_target" ] && at=$i; done
  if [ "$at" -lt 0 ]; then nav_target=${nav_order[0]:-}; return; fi
  i=$((at + d))
  [ "$i" -ge 0 ] && [ "$i" -lt ${#nav_order[@]} ] || return
  nav_target=${nav_order[i]}
  if [[ $nav_target == issue:* ]]; then
    # Coming into the issues from below lands on the last one, from above on the first
    if [ "$d" -lt 0 ]; then nav_select_issue $((issue_total - 1)); else nav_select_issue 0; fi
  fi
}
nav_edge() { # <first|last>
  if [[ $nav_target == issue:* ]]; then
    if [ "$1" = first ]; then nav_select_issue 0; else nav_select_issue $((issue_total - 1)); fi
  elif [ ${#nav_order[@]} -gt 0 ]; then
    if [ "$1" = first ]; then nav_target=${nav_order[0]}; else nav_target=${nav_order[${#nav_order[@]} - 1]}; fi
  fi
}
nav_exit() {
  nav=0
  tmux last-pane -t "$TMUX_PANE" 2>/dev/null || focus_window "$(tmux display -p -t "$TMUX_PANE" '#{window_id}')"
}
# What a click (or Enter in keyboard mode) on a row does
activate() { # <click target>
  case $1 in
    @*) focus_window "$1" ;;
    %*) tmux switch-client -t "$1" ;;
    url:*) open_url "${1#url:}" ;;
    issue:*) issue_open "${1#issue:}" ;;
    todo:*)
      # Optimistic: tick it off here and redraw at once; the other sidebars follow behind
      todo_tick "${1#todo:}"
      "$self" refresh-others "$TMUX_PANE" </dev/null >/dev/null 2>&1 &
      ;;
    todo-edit) "$self" todo-edit ;;
    ttl) issue_ttl_cycle ;;
    recent) minutes_cycle "$RECENT_FILE" ;;
    filter) filter_typing=1 ;;
  esac
}
issue_new() { # the "new issue" popup (claude-issue new)
  local window
  window=$(tmux display -p -t "$TMUX_PANE" '#{window_id}')
  tmux display-popup -E -w 70% -h 70% -T " New issue " "'${self%/*}/claude-issue' new '$window'" </dev/null >/dev/null 2>&1 &
}
issue_open() { # $1 url: the issue view popup (claude-issue), over the window this sidebar is in
  "${self%/*}/claude-issue" open "$1" "$(tmux display -p -t "$TMUX_PANE" '#{window_id}')" </dev/null >/dev/null 2>&1 &
}
# Fetch an issue for the popup in the background, at the text width the popup will have
# (85% of the window, minus borders and margin), so opening it is instant
issue_prefetch() { # $1 url
  [ -n "$1" ] || return
  "${self%/*}/claude-issue" prefetch "$1" $((window_width * 85 / 100 - 4)) </dev/null >/dev/null 2>&1 &
}
issue_prefetch_selected() { issue_url_at "$issue_sel"; issue_prefetch "$issue_url"; }

# How long fetched issues are cached (minutes, used by claude-issue); click or "t" cycles it
ISSUE_TTL_FILE=~/.config/claude-sidebar/issue-ttl
# How long a session counts as having answered recently (orange dot); a click on the
# header's "● 15m" cycles it
RECENT_FILE=~/.config/claude-sidebar/recent-minutes
MINUTE_STEPS=(5 15 30 60) # the values a click cycles through, for both settings

# A minutes setting: its file's number, or 15 (no subshell: this runs on every redraw)
minutes_setting() { # <file> → minutes
  minutes=15
  [ -f "$1" ] && read -r minutes <"$1"
  [[ $minutes =~ ^[0-9]+$ ]] || minutes=15
}
minutes_cycle() { # <file>: on to the next of MINUTE_STEPS
  local minutes next=${MINUTE_STEPS[0]} i
  minutes_setting "$1"
  for i in "${MINUTE_STEPS[@]}"; do
    [ "$i" -gt "$minutes" ] && { next=$i; break; }
  done
  mkdir -p "${1%/*}"
  echo "$next" >"$1"
}
issue_ttl() { local minutes; minutes_setting "$ISSUE_TTL_FILE"; issue_ttl_minutes=$minutes; } # into issue_ttl_minutes
issue_ttl_cycle() { minutes_cycle "$ISSUE_TTL_FILE"; }


# Open a Teams join link in Windows (the browser hands it on to Teams)
open_url() {
  if command -v explorer.exe >/dev/null; then explorer.exe "$1" >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null; then xdg-open "$1" >/dev/null 2>&1 &
  fi
}

# Focus <window> on the pane you were using there, never its sidebar
focus_window() {
  local pane
  pane=$(tmux list-panes -t "$1" -F '#{pane_active} #{pane_last} #{pane_id} #{@claude_sidebar}' |
    awk '$4 != "1" { score = $1 * 2 + $2; if (!found || score > best) { best = score; id = $3; found = 1 } }
         END { print id }')
  [ -n "$pane" ] && tmux switch-client -t "$pane"
}

on() {
  tmux set -g @claude_sidebar_on 1
  tmux set -g status off
  for w in $(tmux list-windows -a -F '#{window_id}'); do add "$w"; done
}

off() {
  tmux set -gu @claude_sidebar_on
  tmux set -g status on
  # When run from inside a sidebar (the q key), close that pane last
  for p in $(sidebar_panes); do [ "$p" = "${TMUX_PANE:-}" ] || tmux kill-pane -t "$p"; done
  sidebar_panes | grep -qx "${TMUX_PANE:-none}" && tmux kill-pane -t "$TMUX_PANE"
}

render() {
  # Mark this pane (also after a tmux-resurrect restore, which starts us without the option)
  tmux set -p -t "$TMUX_PANE" @claude_sidebar 1
  tmux set -g @claude_sidebar_on 1
  tmux set -g status off

  local ESC=$'\e'
  local RESET="$ESC[0m" BOLD="$ESC[1m" DIM="$ESC[38;5;245m"
  local ACTIVE="$ESC[38;5;215m" WINDOW="$ESC[38;5;110m" MARKED="$ESC[38;5;114m"
  # Ask gh for the torgermalling token once; the issue jobs this sidebar starts reuse it
  if command -v gh >/dev/null && [ -z "${CLAUDE_SIDEBAR_GH_TOKEN:-}" ]; then
    CLAUDE_SIDEBAR_GH_TOKEN=$(gh auth token --user torgermalling 2>/dev/null)
    export CLAUDE_SIDEBAR_GH_TOKEN
  fi
  local host continuum last_continuum=0
  host=$(hostname)
  continuum=~/.tmux/plugins/tmux-continuum/scripts/continuum_save.sh
  # Hide the cursor; ask for SGR mouse reports of clicks and of movement (for hover prefetch)
  trap 'printf "%s" "$ESC[?1003l$ESC[?1000l$ESC[?1006l$ESC[?25h$ESC[?7h"; stty echo 2>/dev/null' EXIT
  # Echo off for good, not just while read waits: mouse movement arriving while the sidebar
  # is busy (e.g. starting a prefetch) was otherwise echoed as ^[[<35;… after the footer
  stty -echo 2>/dev/null
  # (no screen clear: every frame overwrites each line and clears below, and a clear here
  # flashed all sidebars whenever they restarted, e.g. on a script change)
  # Autowrap off: a line too long for the pane is cut instead of wrapping onto another row,
  # which pushed the top of the frame out of the pane
  printf '%s' "$ESC[?25l$ESC[?7l$ESC[?1000h$ESC[?1003h$ESC[?1006h"
  local -A click # screen row -> window id (group), pane id (item) or url: (meeting)
  local -a cal_lines cal_urls todo_lines todo_refs todo_all todo_all_refs issue_lines issue_urls issue_rows nav_order
  local issue_offset=0 issue_total=0 issue_sel=0 issue_filter= filter_typing=0 last_hover= followed_issue=
  local nav=0 nav_target= issue_url= window_width=0 window_id= checked_at=-99
  local last_frame= tree_offset=0 tree_top=0 tree_bottom=0 todo_offset=0 todo_top=0 todo_bottom=0 nav_seen=
  local issue_top=0 issue_bottom=-1
  # Only follow issues the popup moves to from now on, not one it showed before we started
  followed_issue=$(tmux show -gv @claude_issue_selected 2>/dev/null)

  local version
  version=$(stat -c %Y "$self")
  while true; do
    # Every 2s at most (not on every key press): the script was edited → restart on the new
    # code (keeps the pane and its options)
    if [ $((SECONDS - checked_at)) -ge 2 ]; then
      [ "$(stat -c %Y "$self")" = "$version" ] || exec "$self" render
    fi
    # This pane's size and state, then the session's panes (for the tree): one tmux call
    local -a tmux_out
    mapfile -t tmux_out < <(tmux display -p -t "$TMUX_PANE" '#{pane_width} #{pane_height} #{window_panes} #{window_active} #{pane_active} #{window_width} #{window_id}' \; list-panes -s -t "$TMUX_PANE" -F "$FMT")
    read -r width height panes visible focused window_width window_id <<<"${tmux_out[0]:-}"
    # tmux resizes panes in proportion when a window changes size: put the sidebar back
    if [ "$visible" = 1 ] && [ "$width" != "$WIDTH" ] && [ "${window_width:-0}" -ge $((WIDTH * 2)) ]; then
      tmux resize-pane -t "$TMUX_PANE" -x "$WIDTH" && width=$WIDTH
    fi
    # Keyboard mode (and typing a filter) ends when you click or move away from the sidebar
    [ "$focused" = 1 ] || { nav=0; filter_typing=0; }
    load_issue_rows
    # Only the sidebar is left in this window: close the window
    if [ "$panes" = 1 ]; then tmux kill-window -t "$TMUX_PANE"; exit 0; fi

    # Only the sidebar you can see draws; hidden ones wait (up to a minute) and are woken by
    # the window-switch hook the moment their window comes into view
    if [ "$visible" = 1 ]; then
      # The window tree first goes into tree_text / tree_click (all of it), so it can be
      # fitted, scrolled, into the room the bottom block leaves
      local out= last_win= row=3
      local -a tree_text=() tree_click=()
      local minutes recent_minutes
      minutes_setting "$RECENT_FILE"
      recent_minutes=$minutes
      click=()
      local today
      printf -v today '%(%F)T' -1
      while IFS=$US read -r wid pid widx wname wactive pactive state title path cmd sidebar opened marked replied; do
        if [ "$widx" != "$last_win" ]; then
          [ -n "$last_win" ] && tree_text+=("") tree_click+=("")
          local colour=$WINDOW
          [ "$marked" = 1 ] && colour=$MARKED
          [ "$wactive" = 1 ] && colour=$ACTIVE # the window you are in stays orange, marked or not

          # When you last switched to this window: "10:15" today, "31.10" on earlier days
          local when= day
          if [ -n "$opened" ]; then
            printf -v day '%(%F)T' "$opened"
            if [ "$day" = "$today" ]; then printf -v when '%(%H:%M)T' "$opened"; else printf -v when '%(%d.%m)T' "$opened"; fi
          fi
          local name=" ${widx} ${wname}" room=$((width - 7))
          [ ${#name} -gt "$room" ] && name="${name:0:room-1}…"
          local line
          printf -v line '%s%s%-*s%s %s' "$colour" "$BOLD" "$room" "$name" "$RESET$DIM" "$when"
          tree_text+=("$line${RESET}") tree_click+=("$wid")
          last_win=$widx
        fi
        [ "$sidebar" != 1 ] || continue
        [ -n "$state" ] || [ "$cmd" = claude ] || continue

        # Claude's pane title is "<spinner> <task summary>"; fall back to the directory name
        title=${title#"${title%%[[:alnum:]]*}"}
        case $title in "" | */* | "$host") title=${path##*/} ;; esac
        local dot
        # red: waiting on you · green: working · orange: answered in the last recent_minutes
        case $state in
          attention) dot="$ESC[1;38;5;203m●" ;;
          running) dot="$ESC[38;5;114m●" ;;
          idle)
            dot="$ESC[38;5;245m●"
            [ -n "$replied" ] && [ $((EPOCHSECONDS - replied)) -lt $((recent_minutes * 60)) ] && dot="$ESC[38;5;214m●"
            ;;
          *) dot="$ESC[38;5;240m○" ;; # Claude is running, but its hooks have not reported yet
        esac
        local marker=' '
        [ "$wactive$pactive" = 11 ] && marker='▸'
        local max=$((width - 7))
        [ ${#title} -gt "$max" ] && title="${title:0:max-1}…"
        local line
        printf -v line '  %s %-*s %s' "$marker" "$max" "$title" "$dot"
        tree_text+=("$line${RESET}") tree_click+=("$pid")
      done < <(printf '%s\n' "${tmux_out[@]:1}")

      # Bottom block, pinned above the footer: todo, calendar and issues, separated by lines.
      # Built as (text, click target) pairs first so the padding above it can be measured.
      local now i rule
      printf -v now '%(%s)T' -1
      printf -v rule '%*s' $((width - 2)) ''
      rule=" ${DIM}${rule// /─}${RESET}"
      local -a b_text=() b_click=() b_nav=()
      todo_lines "$width"
      local b_todo_end=${#todo_lines[@]} # todo rows are b_text[0 .. b_todo_end-1]
      b_nav+=(todo-edit)
      for i in "${todo_all_refs[@]}"; do b_nav+=("todo:$i"); done
      for i in "${!todo_lines[@]}"; do
        b_text+=("${todo_lines[i]}")
        case ${todo_refs[i]} in
          edit) b_click+=(todo-edit) ;;
          [0-9]*) b_click+=("todo:${todo_refs[i]}") ;;
          *) b_click+=("") ;;
        esac
      done
      calendar_lines "$width" "$now"
      if [ ${#cal_lines[@]} -gt 0 ]; then
        b_text+=("" "$rule" "") b_click+=("" "" "")
        for i in "${!cal_lines[@]}"; do
          # No click action on meetings: explorer.exe opened the Documents folder for Teams
          # links, and new Outlook has no documented link straight to its calendar
          b_text+=("${cal_lines[i]}") b_click+=("")
        done
      fi
      # On a short pane the issues give up rows first, so the tree keeps at least 3 (block:
      # rule and blank lines, header, a filter line, the issues, the cache line)
      local tree_want=${#tree_text[@]} filter_row=0
      [ "$tree_want" -le 3 ] || tree_want=3
      { [ "$filter_typing" = 1 ] || [ -n "$issue_filter" ]; } && filter_row=1
      issue_rows_vis=$((height - 2 - ${#b_text[@]} - 3 - 1 - filter_row - 1 - 2 - 1 - tree_want))
      [ "$issue_rows_vis" -le "$ISSUES_ROWS" ] || issue_rows_vis=$ISSUES_ROWS
      [ "$issue_rows_vis" -ge 1 ] || issue_rows_vis=1
      issue_scroll 0
      issue_lines "$width"
      local b_issue_start=-1 # issue rows are b_text[b_issue_start ..] (to the end)
      if [ ${#issue_lines[@]} -gt 0 ]; then
        b_text+=("" "$rule" "") b_click+=("" "" "")
        b_issue_start=${#b_text[@]}
        for i in "${!issue_lines[@]}"; do
          b_text+=("${issue_lines[i]}")
          case ${issue_urls[i]} in
            ttl | filter) b_click+=("${issue_urls[i]}") ;;
            '') b_click+=("") ;;
            *) b_click+=("issue:${issue_urls[i]}") ;;
          esac
          [ -n "${b_click[-1]}" ] && [ "${b_click[-1]}" != filter ] && b_nav+=("${b_click[-1]}")
        done
      fi

      # The tree gets the rows the bottom block, header and footer leave (at least 3); when
      # it does not fit, it scrolls (mouse wheel), and keyboard mode keeps its selection in view
      local tree_total=${#tree_text[@]} tree_rows
      tree_rows=$((height - 2 - ${#b_text[@]} - 2 - 1))
      [ "$tree_rows" -ge 1 ] || tree_rows=1
      [ "$tree_rows" -le "$tree_total" ] || tree_rows=$tree_total
      if [ "$nav" = 1 ] && [ "$nav_target" != "$nav_seen" ]; then
        for i in "${!tree_click[@]}"; do
          [ "${tree_click[i]}" = "$nav_target" ] || continue
          [ "$i" -ge "$tree_offset" ] || tree_offset=$i
          [ "$i" -lt $((tree_offset + tree_rows)) ] || tree_offset=$((i - tree_rows + 1))
        done
      fi
      [ "$tree_offset" -le $((tree_total - tree_rows)) ] || tree_offset=$((tree_total - tree_rows))
      [ "$tree_offset" -ge 0 ] || tree_offset=0
      local more head
      scroll_marks "$tree_offset" $((tree_total - tree_offset - tree_rows))
      # Scrolled, the header says how many windows there are: "Windows (8)"
      local title=" Claude Code" n=0
      if [ "$tree_rows" -lt "$tree_total" ]; then
        for i in "${tree_click[@]}"; do [[ $i == @* ]] && n=$((n + 1)); done
        title=" Windows ($n)"
      fi
      # "● 15m": how long the orange "answered recently" dot lasts; a click changes it
      local recent_plain="● ${recent_minutes}m${more:+ $more}" gap
      printf -v gap '%*s' $((width - ${#title} - ${#recent_plain} - 1)) ''
      head="$BOLD$title$RESET$gap$ESC[38;5;214m●$RESET$DIM ${recent_minutes}m${more:+ $more}$RESET"
      out="$head${ESC}[K"$'\n'"${ESC}[K"$'\n'
      click[1]=recent
      tree_top=3
      for ((i = tree_offset; i < tree_offset + tree_rows; i++)); do
        out+="${tree_text[i]}${ESC}[K"$'\n'
        [ -n "${tree_click[i]}" ] && click[$row]=${tree_click[i]}
        row=$((row + 1))
      done
      tree_bottom=$((row - 1))

      local pad=$((height - (row - 1) - ${#b_text[@]} - 2))
      [ "$pad" -ge 1 ] || pad=1
      for ((i = 0; i < pad; i++)); do out+="${ESC}[K"$'\n'; done
      row=$((row + pad))
      todo_top=$row todo_bottom=$((row + b_todo_end - 1))
      issue_top=0 issue_bottom=-1
      [ "$b_issue_start" -ge 0 ] && issue_top=$((row + b_issue_start)) issue_bottom=$((row + ${#b_text[@]} - 1))
      for i in "${!b_text[@]}"; do
        out+="${b_text[i]}${ESC}[K"$'\n'
        [ -n "${b_click[i]}" ] && click[$row]=${b_click[i]}
        row=$((row + 1))
      done

      local footer="q close · R refresh · / filter"
      [ "$nav" = 1 ] && footer="⏎ open · / filter · n new · esc"
      [ "$nav" = 1 ] && [ -n "$issue_filter" ] && footer="⏎ open · esc clear filter"
      [ "$filter_typing" = 1 ] && footer="filtering · ⏎ keep · esc clear"
      out+="${ESC}[K"$'\n'"${DIM}  ${footer}${RESET}${ESC}[K"

      # Rows you can act on, top to bottom, for keyboard mode; and its highlight: a grey bar
      # across the selected row, kept through the row's own colour resets
      # (the whole tree and all todos, also those scrolled out of view)
      local r sel_row=
      nav_order=()
      for r in "${tree_click[@]}"; do [ -n "$r" ] && nav_order+=("$r"); done
      nav_order+=("${b_nav[@]}")
      nav_seen=$nav_target
      for ((r = 1; r <= height; r++)); do
        [ "$nav" = 1 ] && [ "${click[$r]:-}" = "$nav_target" ] && sel_row=$r
      done
      if [ -n "$sel_row" ]; then
        local -a frame
        mapfile -t frame <<<"$out"
        local SELBG="$ESC[48;5;238m" line=${frame[sel_row - 1]}
        line="${line%"${ESC}[K"}"
        [ "${line:0:1}" = " " ] && line="${ESC}[38;5;215m▸${RESET}${line:1}"
        frame[sel_row - 1]="${SELBG}${line//$RESET/$RESET$SELBG}${ESC}[K${RESET}"
        printf -v out '%s\n' "${frame[@]}"
        out=${out%$'\n'}
      fi
      # Synchronized output (mode 2026): tmux shows the frame only once it is complete.
      # Unchanged frames are not sent again: tmux keeps the pane's contents, and every
      # redraw under an open popup made tmux repaint the popup over it (a flicker every 2s)
      if [ "$out" != "$last_frame" ]; then
        printf '%s' "$ESC[?2026h$ESC[H$out$ESC[J$ESC[?2026l"
        last_frame=$out
      fi
    fi

    # The status bar normally drives tmux-continuum's autosave; with it hidden, the
    # visible sidebar does (continuum itself still only saves every @continuum-save-interval)
    if [ "$visible" = 1 ] && [ $((SECONDS - last_continuum)) -ge 60 ] && [ -x "$continuum" ]; then
      "$continuum" </dev/null >/dev/null 2>&1 &
      last_continuum=$SECONDS
    fi
    # Whether the calendar or issues are due a refetch: checked every 2s, not on every key
    if [ "$visible" = 1 ] && [ $((SECONDS - checked_at)) -ge 2 ]; then
      calendar_fetch
      issues_fetch
    fi
    [ $((SECONDS - checked_at)) -ge 2 ] && checked_at=$SECONDS

    # Wait up to 2s; `refresh` wakes us early by typing "r" into this pane. Everything that
    # arrived is then handled token by token: mouse reports, arrow keys, Esc, single keys.
    # (-d '' so Enter arrives as a newline instead of ending the read)
    # Mouse movement (hover) prefetches without a redraw, so moving over the sidebar stays cheap.
    local key k tok acted=0 waited_from=$SECONDS wait_for=2
    [ "$visible" = 1 ] || wait_for=60
    while [ "$acted" = 0 ] && [ $((SECONDS - waited_from)) -lt "$wait_for" ] &&
      IFS= read -rsn1 -d '' -t "$wait_for" key; do
      while IFS= read -rsn1 -d '' -t 0.01 k; do key+=$k; done
      while [ -n "$key" ]; do
        if [[ $key =~ ^$'\e'\[\<([0-9]+)\;[0-9]+\;([0-9]+)([Mm]) ]]; then
          # SGR mouse report: ESC [ < button ; column ; row M (press) or m (release)
          tok=${BASH_REMATCH[0]}
          [ "${BASH_REMATCH[1]}" = 35 ] || acted=1
          case ${BASH_REMATCH[1]}${BASH_REMATCH[3]} in
            35M) # movement with no button held: hover
              local hovered=${click[${BASH_REMATCH[2]}]:-}
              if [[ $hovered == issue:* && $hovered != "$last_hover" ]]; then
                issue_prefetch "${hovered#issue:}"
              fi
              last_hover=$hovered
              ;;
            64M | 65M) # wheel: scroll the list under the mouse (elsewhere, nothing)
              local d=1 at=${BASH_REMATCH[2]}
              [ "${BASH_REMATCH[1]}" = 64 ] && d=-1
              if [ "$at" -ge "$tree_top" ] && [ "$at" -le "$tree_bottom" ]; then tree_offset=$((tree_offset + d))
              elif [ "$at" -ge "$todo_top" ] && [ "$at" -le "$todo_bottom" ]; then todo_offset=$((todo_offset + d))
              elif [ "$at" -ge "$issue_top" ] && [ "$at" -le "$issue_bottom" ]; then issue_scroll "$d"; fi
              ;;
            0M) activate "${click[${BASH_REMATCH[2]}]:-}" ;;
          esac
        elif [[ $key == $'\e'[[O][AB]* ]]; then
          acted=1
          tok=${key:0:3}
          if [ "$filter_typing" = 0 ] && [ "$nav" = 1 ]; then
            if [ "${tok:2}" = A ]; then nav_move -1; else nav_move 1; fi
          fi
        elif [[ $key == $'\e'* ]]; then
          acted=1
          tok=${key:0:1}
          if [ "$filter_typing" = 1 ]; then
            filter_typing=0 issue_filter= issue_offset=0 issue_sel=0
          elif [ -n "$issue_filter" ]; then
            # A filter is applied: Esc clears it first (keeping the selected issue selected,
            # now in the whole list); the next Esc leaves keyboard mode
            issue_filter=
            load_issue_rows
            if [ "$nav" = 1 ] && [[ $nav_target == issue:* ]]; then
              local at
              at=$(issue_index_of "${nav_target#issue:}")
              nav_select_issue "${at:-0}"
            else
              issue_offset=0 issue_sel=0
            fi
          elif [ "$nav" = 1 ]; then
            nav_exit
          fi
        else
          acted=1
          tok=${key:0:1}
          case $tok in
            $'\x12') # redraw request (claude-sidebar refresh); the issue popup also uses it
              # to say which issue it shows, which gets selected and scrolled into view
              local shown at
              shown=$(tmux show -gv @claude_issue_selected 2>/dev/null)
              if [ -n "$shown" ] && [ "$shown" != "$followed_issue" ]; then
                followed_issue=$shown
                at=$(issue_index_of "$shown")
                if [ -n "$at" ]; then
                  issue_sel=$at
                  issue_move 0
                  [ "$nav" = 1 ] && nav_target="issue:$shown"
                fi
              fi
              ;;
            $'\x14') # prefix i (claude-sidebar focus issues): keyboard into the issue list
              nav=1
              [ "$issue_sel" -ge "$issue_offset" ] && [ "$issue_sel" -lt $((issue_offset + issue_rows_vis)) ] || issue_sel=$issue_offset
              [ "$issue_total" -gt 0 ] && nav_select_issue "$issue_sel"
              ;;
            $'\x05') # prefix e (claude-sidebar focus sidebar): keyboard into the sidebar,
              # starting on the pane you came from if it is a Claude session, else its window
              nav=1
              local came_from
              came_from=$(tmux list-panes -t "$TMUX_PANE" -F '#{pane_last} #{pane_id}' | awk '$1 == 1 { print $2 }')
              nav_target=$(tmux display -p -t "$TMUX_PANE" '#{window_id}')
              local r
              for r in "${!click[@]}"; do [ "${click[$r]}" = "$came_from" ] && nav_target=$came_from; done
              ;;
            *)
              if [ "$filter_typing" = 1 ]; then
                # Typing a filter: every printable key goes into it
                case $tok in
                  $'\n' | $'\r')
                    filter_typing=0
                    [ "$nav" = 1 ] && [ "$issue_total" -gt 0 ] && nav_select_issue 0
                    ;;
                  $'\x7f' | $'\b') issue_filter=${issue_filter%?} issue_offset=0 issue_sel=0 ;;
                  [[:print:]]) issue_filter+=$tok issue_offset=0 issue_sel=0 ;;
                esac
              else
                case $tok in
                  /) filter_typing=1 ;;
                  t) [ "$nav" = 1 ] && issue_ttl_cycle ;;
                  n) [ "$nav" = 1 ] && issue_new ;;
                  j) [ "$nav" = 1 ] && nav_move 1 ;;
                  k) [ "$nav" = 1 ] && nav_move -1 ;;
                  g) [ "$nav" = 1 ] && nav_edge first ;;
                  G) [ "$nav" = 1 ] && nav_edge last ;;
                  $'\n' | $'\r') [ "$nav" = 1 ] && activate "$nav_target" ;;
                  q)
                    if [ "$nav" = 1 ]; then nav_exit; else
                      off
                      exit 0
                    fi
                    ;;
                  a) "$self" todo-prompt ;;
                  e) "$self" todo-edit ;;
                  R)
                    calendar_fetch force
                    issues_fetch force
                    ;;
                esac
              fi
              ;;
          esac
        fi
        key=${key:${#tok}}
      done
    done
  done
}

case ${1:-} in
toggle) if [ "$(tmux show -gv @claude_sidebar_on 2>/dev/null)" = 1 ]; then off; else on; fi ;;
add) [ "$(tmux show -gv @claude_sidebar_on 2>/dev/null)" = 1 ] && add "$2" ;;
refresh) refresh_others ;; # C-r is \x12, not a letter: no typing clash
refresh-others) refresh_others "$2" ;;
opened)
  # Window switch hook: remember when <window> was opened, then redraw
  tmux set -w -t "$2" @last_opened "$(date +%s)"
  "$self" refresh
  ;;
render) render ;;
mark)
  # Toggle a window's mark (default: the current one): a visual tag for the projects you
  # are switching between
  win=${2:-$(tmux display -p '#{window_id}')}
  if [ "$(tmux show -wv -t "$win" @claude_marked 2>/dev/null)" = 1 ]; then
    tmux set -wu -t "$win" @claude_marked
  else
    tmux set -w -t "$win" @claude_marked 1
  fi
  "$self" refresh
  ;;
focus | issues-focus)
  # prefix e (focus sidebar) / prefix i (focus issues): keyboard into the current window's sidebar
  [ "$(tmux show -gv @claude_sidebar_on 2>/dev/null)" = 1 ] || on
  win=$(tmux display -p '#{window_id}')
  for _ in $(seq 20); do # a sidebar that was just opened needs a moment to mark itself
    sb=$(tmux list-panes -t "$win" -F '#{pane_id} #{@claude_sidebar}' | awk '$2 == "1" { print $1 }')
    [ -n "$sb" ] && break
    sleep 0.1
  done
  [ -n "$sb" ] || exit 0
  tmux select-pane -t "$sb"
  if [ "$1" = issues-focus ] || [ "${2:-}" = issues ]; then tmux send-keys -t "$sb" C-t; else tmux send-keys -t "$sb" C-e; fi
  ;;
focus-in)
  # Terminal regained focus (tmux hook): if an issue was opened from the sidebar, refetch now
  # and again 30s later, since GitHub's search can take a little while to see a change
  [ "$(tmux show -gv @claude_issues_dirty 2>/dev/null)" = 1 ] || exit 0
  tmux set -gu @claude_issues_dirty
  issues_fetch force
  (sleep 30 && issues_fetch force) >/dev/null 2>&1 &
  ;;
todo-prompt)
  # A one-line popup reads the todo itself, so tmux never parses (or expands $ in) the text
  tmux display-popup -E -w 60% -h 3 -T " New todo " "'$self' todo-read"
  ;;
todo-read)
  read -r -e -p " " text || exit 0
  text=$(printf '%s' "$text" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')
  [ -n "$text" ] || exit 0
  mkdir -p "${TODO_FILE%/*}"
  [ -s "$TODO_FILE" ] && [ -n "$(tail -c1 "$TODO_FILE")" ] && echo >>"$TODO_FILE"
  printf -- '- [ ] %s\n' "$text" >>"$TODO_FILE"
  "$self" refresh
  ;;
todo-done)
  todo_tick "$2"
  refresh_others
  ;;
todo-edit)
  mkdir -p "${TODO_FILE%/*}"
  touch "$TODO_FILE"
  tmux display-popup -E -w 70% -h 60% -T " Todo " "${EDITOR:-nvim} '$TODO_FILE'; '$self' refresh"
  ;;
*)
  echo "usage: claude-sidebar toggle | add <window-id> | mark [window-id] | opened <window-id> | refresh | render | todo-prompt | todo-read | todo-done <line> | todo-edit | focus-in | focus [issues]" >&2
  exit 1
  ;;
esac
exit 0
