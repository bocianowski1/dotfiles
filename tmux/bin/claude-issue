#!/usr/bin/env bash
# Issue view for the tmux Claude sidebar:
#   claude-issue view <issue-url> <window-id>   the popup (run inside tmux display-popup)
#   claude-issue open <issue-url> <window-id>   open the popup over <window> (the sidebar uses this)
#   claude-issue prefetch <issue-url> <width>   cache the issue for a popup of that text width
#                                                (the sidebar runs this on hover/selection)
#   claude-issue new <window-id>                "new issue" popup: pick a repo, write, create
#                                                (n in the sidebar's issue list)
#   claude-issue images <issue-url> <base> <n> <window-id>
#                                               full-size image viewer (sixel) in its own window
# Fetched issues are cached for the minutes in ~/.config/claude-sidebar/issue-ttl (default 15).
# Images in the description are drawn below it (claude-issue-image), loading in the background.
# Shows the issue (title, metadata, description) with gh's own rendering. Keys:
#   ↑/↓      previous/next issue in the sidebar's list (the sidebar follows)
#   j/k scroll · space/b page · g/G top/bottom
#   o        open in the browser (and close)
#   s        copy the issue's link to the clipboard (share)
#   c        start Claude Code in a new pane of <window>, in the repo's local clone,
#            with a prompt to branch off and implement/fix the issue (and close); the
#            pane remembers the issue (@claude_issue). If a session already works on
#            the issue, c goes to it instead of starting a second one
#   v        view the images full size (sixel, in a window: tmux shows no sixel in popups)
#   x        close the issue on GitHub, after confirming: y completed · n not planned
#   ⌫ q Esc  close
# CLAUDE_ISSUE_DRYRUN=1 makes "c" print the pane command and prompt instead of running it,
# and "x" skip the GitHub call. CLAUDE_SIDEBAR_CACHE overrides ~/.cache/claude-sidebar.
# Sourced (as the tests do), it only defines its functions.
set -uo pipefail
# shellcheck source=../lib/common.sh
source "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/lib/common.sh"
CODE_DIR=~/code
PROMPTS=$CACHE_DIR/prompts
VIEW_CACHE=$CACHE_DIR/issue-view

gh_token # the GH_USER token, whichever gh account is active
export GH_PAGER=cat

# Local clone of owner/repo under CODE_DIR: real clones only (a worktree's .git is a file),
# matched on the origin remote, preferring the folder named after the repo
find_clone() {
  local want=${1,,} name=${1##*/} best='' dir remote
  while IFS= read -r dir; do
    remote=$(git -C "$dir" remote get-url origin 2>/dev/null) || continue
    remote=${remote,,}
    remote=${remote%.git}
    [[ $remote == */"$want" || $remote == *:"$want" ]] || continue
    if [ "${dir##*/}" = "$name" ]; then
      echo "$dir"
      return
    fi
    [ -n "$best" ] || best=$dir
  done < <(find "$CODE_DIR" -maxdepth 6 -name .git -type d -prune 2>/dev/null | sed 's|/\.git$||' | sort)
  [ -n "$best" ] && echo "$best"
}

# A pane of <window> to split: the one you were using, never the sidebar
work_pane() {
  tmux list-panes -t "$1" -F '#{pane_active} #{pane_last} #{pane_id} #{@claude_sidebar}' |
    awk '$4 != "1" { score = $1 * 2 + $2; if (!found || score > best) { best = score; id = $3; found = 1 } }
         END { print id }'
}

branch_name() { # <number> <title> <labels>
  local type=feat slug
  [[ ,${3,,}, == *,bug,* ]] && type=fix
  slug=$(printf '%s' "${2,,}" | sed 's/æ/ae/g; s/ø/o/g; s/å/a/g' | tr -c 'a-z0-9' '-' | tr -s '-' | sed 's/^-//; s/-$//')
  slug=${slug:0:40}
  echo "$type/$1-${slug%-}"
}

start_claude() { # <owner/repo> <number> <title> <labels> <url> <window>
  local repo=$1 num=$2 title=$3 labels=$4 url=$5 window=$6 dir pane branch prompt_file existing
  # A Claude session (still running) already on this issue: go there instead
  existing=$(tmux list-panes -a -F '#{pane_id} #{@claude_state} #{@claude_issue}' |
    awk -v u="$url" '$2 != "" && $3 == u { print $1; exit }')
  if [ -n "$existing" ]; then
    if [ "${CLAUDE_ISSUE_DRYRUN:-}" = 1 ]; then
      mkdir -p "$PROMPTS"
      echo "existing $existing" >"$PROMPTS/dryrun.txt"
      return 0
    fi
    tmux switch-client -t "$existing"
    tmux display-message "Already a Claude session on $repo#$num: switched to it"
    return 0
  fi
  dir=$(find_clone "$repo") || true
  if [ -z "$dir" ]; then
    message="No local clone of $repo under ${CODE_DIR/#$HOME/\~}"
    return 1
  fi
  branch=$(branch_name "$num" "$title" "$labels")
  mkdir -p "$PROMPTS"
  prompt_file="$PROMPTS/${repo//\//-}-$num.md"
  cat >"$prompt_file" <<EOF
Work on GitHub issue $repo#$num: "$title"
$url

1. Read the full issue, including comments: \`gh issue view $num -R $repo --comments\`
2. Check that the working tree is clean (stop and ask me if it is not), update the default branch, and create a new branch from it named \`$branch\`.
3. Investigate the relevant code. For a bug: reproduce it and find the root cause. For a feature: work out where it fits and what has to change. Explain what you found and give a short implementation plan, then wait for my go-ahead before changing code.
4. Implement it following this repo's conventions, with tests that cover the change, and run the tests.
5. Do not push or open a pull request until I ask.
EOF
  pane=$(work_pane "$window")
  # Claude starts with the prompt; when it exits, the pane stays as a shell in the repo
  local cmd=(tmux split-window -h -P -F '#{pane_id}' -t "$pane" -c "$dir" -- bash -c 'claude "$(cat "$1")"; exec bash' _ "$prompt_file")
  if [ "${CLAUDE_ISSUE_DRYRUN:-}" = 1 ]; then
    printf '%q ' "${cmd[@]}" >"$PROMPTS/dryrun.txt"
    return 0
  fi
  local new
  # The pane remembers its issue: the sidebar shows it, and c finds the session again
  new=$("${cmd[@]}") && tmux set -p -t "$new" @claude_issue "$url"
}

# Cache files for an issue rendered at a text width: <base>.txt (gh's rendering),
# <base>.meta (title, labels, then the markdown body) and the images: <base>.img<N>.txt
# (drawn), <base>.img<N>.name, and <base>.images once all are done (holding the count).
# gh formats for a width, so the width is part of the key.
# CACHE_FORMAT changes when what is cached changes, so older cache files are not trusted
CACHE_FORMAT=3                                                        # 2: .meta carries the body (for images); 3: keeps the originals (.src)
cache_base() { echo "$VIEW_CACHE/${1//\//_}_$2_w$3_v$CACHE_FORMAT"; } # <owner/repo> <number> <width>

cache_fresh() { # <base>: fetched less than ISSUE_TTL_FILE's minutes ago
  [ -s "$1.txt" ] && [ -f "$1.meta" ] || return 1
  local minutes
  minutes_setting "$ISSUE_TTL_FILE"
  [ $((EPOCHSECONDS - $(stat -c %Y "$1.txt"))) -lt $((minutes * 60)) ]
}

# Fetch an issue into the cache unless it is fresh. "wait" blocks on a fetch already
# running for it (the popup); "skip" leaves that one to finish on its own (prefetch).
fetch_issue() { # <owner/repo> <number> <width> <wait|skip>
  local repo=$1 num=$2 width=$3 base
  base=$(cache_base "$repo" "$num" "$width")
  mkdir -p "$VIEW_CACHE"
  exec 9>"$base.lock"
  if [ "$4" = skip ]; then flock -n 9 || return 0; else flock 9; fi
  if cache_fresh "$base"; then
    # Images can be missing on their own (an earlier run was cut short): fetch just those
    [ -f "$base.images" ] || fetch_images "$repo" "$width" "$base" 9>&- >/dev/null 2>&1 &
    return 0
  fi
  local text meta
  GH_FORCE_TTY=$width gh issue view "$num" -R "$repo" >"$base.txt.tmp" 2>&1 &
  text=$!
  gh issue view "$num" -R "$repo" --json title,labels,body --jq '.title, ([.labels[].name] | join(",")), .body' >"$base.meta.tmp" 2>/dev/null &
  meta=$!
  if wait "$text" && wait "$meta"; then
    chmod 600 "$base.txt.tmp" "$base.meta.tmp"
    mv "$base.txt.tmp" "$base.txt"
    mv "$base.meta.tmp" "$base.meta"
    rm -f "$base.err" "$base.images"
    # Images load in the background (without our lock, so the popup can show the text now)
    fetch_images "$repo" "$width" "$base" 9>&- >/dev/null 2>&1 &
  else
    # Never cache a failure: keep gh's message for the popup to show
    mv "$base.txt.tmp" "$base.err"
    rm -f "$base.meta.tmp"
  fi
}

IMAGE_MAX=8       # images per issue
IMAGE_MAX_ROWS=40 # text rows per image

# Download an image linked from an issue. Repo files (blob/raw links) go through the contents
# API and GitHub attachments get the token; the token is never sent to other hosts.
download_image() { # <url> <file>
  local url=${1%%\?*} file=$2
  if [[ $url =~ ^https://github\.com/([^/]+/[^/]+)/(blob|raw)/([^/]+)/(.+)$ ]] ||
    [[ $url =~ ^https://raw\.githubusercontent\.com/([^/]+/[^/]+)/()([^/]+)/(.+)$ ]]; then
    gh api -H "Accept: application/vnd.github.raw" \
      "repos/${BASH_REMATCH[1]}/contents/${BASH_REMATCH[4]}?ref=${BASH_REMATCH[3]}" >"$file"
  elif [[ $1 =~ ^https://(github\.com|private-user-images\.githubusercontent\.com)/ ]]; then
    curl -fsSL --max-time 30 -H "Authorization: Bearer $GH_TOKEN" -o "$file" "$1"
  else
    curl -fsSL --max-time 30 -o "$file" "$1"
  fi
}

# Images in the issue body (markdown ![alt](url) and <img alt src>), drawn into the cache
fetch_images() { # <owner/repo> <width> <base>
  local width=$2 base=$3 n=0 alt url
  exec 8>"$base.imglock"
  flock -n 8 || return 0
  rm -f "$base".img[0-9]*
  while IFS=$'\t' read -r alt url; do
    [ "$n" -lt "$IMAGE_MAX" ] || break
    n=$((n + 1))
    printf '%s\n' "${alt:-image $n}" >"$base.img$n.name"
    if download_image "$url" "$base.img$n.src" 2>/dev/null &&
      "$(dirname "$(readlink -f "$0")")/claude-issue-image" "$base.img$n.src" $((width - 4)) "$IMAGE_MAX_ROWS" >"$base.img$n.tmp" 2>/dev/null; then
      mv "$base.img$n.tmp" "$base.img$n.txt"
    else
      printf '\e[38;5;245m(could not load %s)\e[0m\n' "$url" >"$base.img$n.txt"
    fi
    rm -f "$base.img$n.tmp"
    chmod 600 "$base.img$n".*
  done < <(tail -n +3 "$base.meta" | grep -oE '!\[[^]]*\]\([^) ]+\)|<img [^>]*>' | sed -E \
    -e 's/^!\[([^]]*)\]\(([^) ]+)\)$/\1\t\2/' \
    -e '/^<img/{ s/.*alt="([^"]*)".*src="([^"]+)".*/\1\t\2/; s/.*src="([^"]+)".*alt="([^"]*)".*/\2\t\1/; s/^<img .*src="([^"]+)".*/\t\1/ }')
  echo "$n" >"$base.images"
}

# The Windows clipboard under WSL, else Wayland; tmux's own buffer as well, so prefix ]
# pastes it too
copy_to_clipboard() { # <text>
  tmux set-buffer -- "$1"
  if command -v clip.exe >/dev/null; then
    printf '%s' "$1" | clip.exe
  elif command -v wl-copy >/dev/null; then
    printf '%s' "$1" | wl-copy
  fi
}

drop_cached() { rm -f "$VIEW_CACHE/${1//\//_}_$2_w"*; } # <owner/repo> <number>

open_in_browser() {
  if command -v explorer.exe >/dev/null; then
    explorer.exe "$1" >/dev/null 2>&1
  elif command -v xdg-open >/dev/null; then
    xdg-open "$1" >/dev/null 2>&1 &
  fi
  # The sidebar refetches its issues when you come back to the terminal
  tmux set -g @claude_issues_dirty 1
}

# Close an issue optimistically: drop it from the sidebar's list straight away (and remember
# it for claude-issues, since GitHub's search can list a closed issue as open for a while),
# then close it on GitHub in the background. If that fails, the issue comes back and tmux
# shows why. The popup can exit at once; the background job is detached from it.
close_issue() { # <owner/repo> <number> <completed|not planned>
  local repo=$1 num=$2 reason=$3 url="https://github.com/$1/issues/$2" row here
  here=$(dirname "$(readlink -f "$0")")
  row=$(awk -F'\t' -v u="$url" '$5 == u' "$CACHE_DIR/issues.tsv" 2>/dev/null)
  printf '%s\t%s\n' "$url" "$(date +%s)" >>"$CACHE_DIR/closed.tsv"
  drop_cached "$repo" "$num"
  if [ -f "$CACHE_DIR/issues.tsv" ]; then
    awk -F'\t' -v u="$url" '$5 != u' "$CACHE_DIR/issues.tsv" >"$CACHE_DIR/issues.tsv.tmp" &&
      mv "$CACHE_DIR/issues.tsv.tmp" "$CACHE_DIR/issues.tsv"
  fi
  "$here/claude-sidebar" refresh >/dev/null 2>&1
  setsid -f "$here/claude-issue" close-on-github "$repo" "$num" "$reason" "$row" </dev/null >/dev/null 2>&1
}

# The GitHub half of close_issue; undoes the optimistic update if GitHub says no.
# CLAUDE_ISSUE_DRYRUN=1 skips the call (succeeds); CLAUDE_ISSUE_FAIL=1 fakes a failure.
close_on_github() { # <owner/repo> <number> <reason> <cache row>
  local repo=$1 num=$2 reason=$3 row=$4 url="https://github.com/$1/issues/$2" err='' here
  here=$(dirname "$(readlink -f "$0")")
  if [ "${CLAUDE_ISSUE_FAIL:-}" = 1 ]; then
    err="simulated failure"
  elif [ "${CLAUDE_ISSUE_DRYRUN:-}" != 1 ]; then
    err=$(gh issue close "$num" -R "$repo" --reason "$reason" 2>&1 >/dev/null) && err=
  fi
  [ -n "$err" ] || return 0
  # Put it back: no longer "recently closed", and back in the list (the refetch sorts it)
  if [ -f "$CACHE_DIR/closed.tsv" ]; then
    awk -F'\t' -v u="$url" '$1 != u' "$CACHE_DIR/closed.tsv" >"$CACHE_DIR/closed.tsv.tmp" &&
      mv "$CACHE_DIR/closed.tsv.tmp" "$CACHE_DIR/closed.tsv"
  fi
  if [ -n "$row" ]; then
    {
      printf '%s\n' "$row"
      cat "$CACHE_DIR/issues.tsv" 2>/dev/null
    } >"$CACHE_DIR/issues.tsv.tmp" &&
      mv "$CACHE_DIR/issues.tsv.tmp" "$CACHE_DIR/issues.tsv"
    chmod 600 "$CACHE_DIR/issues.tsv"
  fi
  "$here/claude-sidebar" refresh >/dev/null 2>&1
  tmux display-message -d 8000 "Could not close $repo#$num: ${err%%$'\n'*}"
  (flock -n "$CACHE_DIR/issues.lock" "$here/claude-issues" && "$here/claude-sidebar" refresh) >/dev/null 2>&1
}

# The issue popup over <window>: 85% of the screen, titled with the issue
open_popup() { # <url> <window>
  local ref
  ref=$(sed -E 's#.*github\.com/[^/]+/([^/]+)/issues/([0-9]+).*#\1\#\2#' <<<"$1")
  tmux display-popup -E -w 85% -h 85% -T " $ref " "'$(readlink -f "$0")' view '$1' '$2'"
}

# Full-size images of an issue, as sixel in this (temporary) window. ←/→ switch image,
# ⌫ q Esc go back: close this window and reopen the popup on the issue.
images() { # <url> <base> <n> <window>
  local url=$1 base=$2 n=$3 window=$4 total key k
  local ESC=$'\e'
  local DIM="${ESC}[38;5;245m" KEY="${ESC}[38;5;215m" RESET="${ESC}[0m"
  total=$(cat "$base.images" 2>/dev/null || echo 0)
  trap 'printf "\e[?25h"; stty echo 2>/dev/null' EXIT # (literal: locals are gone by then)
  stty -echo 2>/dev/null
  printf '%s' "${ESC}[?25l"
  while true; do
    local cols rows cw ch name six
    read -r cols rows cw ch < <(tmux display -p -t "$TMUX_PANE" '#{pane_width} #{pane_height} #{client_cell_width} #{client_cell_height}')
    name=$(cat "$base.img$n.name" 2>/dev/null)
    printf '%s' "${ESC}[2J${ESC}[H ${KEY}▣${RESET} $name  ${DIM}($n/$total)${RESET}"
    printf '%s' "${ESC}[$rows;1H ${KEY}←/→${DIM} image · ${KEY}⌫${DIM} back to the issue${RESET}"
    printf '%s' "${ESC}[3;3H"
    # Fit inside the window (between the title and the footer); drawn once per size
    six="$base.img$n.${cols}x${rows}.six"
    if [ ! -s "$six" ] && [ -f "$base.img$n.src" ]; then
      printf '%s' "${DIM}drawing…${RESET}${ESC}[3;3H"
      "$(dirname "$(readlink -f "$0")")/claude-issue-image" --sixel "$base.img$n.src" \
        $(((cols - 4) * ${cw:-10})) $(((rows - 5) * ${ch:-20})) >"$six.tmp" 2>/dev/null && mv "$six.tmp" "$six"
      chmod 600 "$six" 2>/dev/null
    fi
    if [ -s "$six" ]; then cat "$six"; else printf '%s' "${DIM}(this image could not be loaded)${RESET}"; fi

    IFS= read -rsn1 -d '' key || exit 0
    while IFS= read -rsn1 -d '' -t 0.01 k; do key+=$k; done
    case $key in
    $'\e[C' | $'\eOC' | l) [ "$n" -lt "$total" ] && n=$((n + 1)) ;;
    $'\e[D' | $'\eOD' | h) [ "$n" -gt 1 ] && n=$((n - 1)) ;;
    $'\x7f' | $'\b' | q | $'\e')
      # From the server, not this pane (which goes away): close this window, then the popup
      tmux run-shell -b "tmux kill-window -t '$TMUX_PANE'; '$(readlink -f "$0")' open '$url' '$window'"
      sleep 5
      exit 0
      ;;
    esac
  done
}

# Repos to offer for a new issue, from the orgs your issues come from, most relevant first:
# those you already have open issues in (most issues first), then those cloned under
# CODE_DIR, then the rest of those orgs.
# The org listing is cached for a day in repos.txt and refreshed in the background.
REPOS_CACHE=$CACHE_DIR/repos.txt
refresh_repo_list() {
  local owners
  owners=$({ sed -E 's#https://github\.com/([^/]+)/.*#\1#' <(cut -f5 "$CACHE_DIR/issues.tsv" 2>/dev/null); } | sort -u)
  [ -n "$owners" ] || return 0
  local o
  for o in $owners; do
    gh repo list "$o" --limit 200 --json nameWithOwner,isArchived --jq '.[] | select(.isArchived | not) | .nameWithOwner'
  done | sort -fu >"$REPOS_CACHE.tmp" && [ -s "$REPOS_CACHE.tmp" ] && mv "$REPOS_CACHE.tmp" "$REPOS_CACHE"
  rm -f "$REPOS_CACHE.tmp"
}
repo_choices() {
  {
    cut -f5 "$CACHE_DIR/issues.tsv" 2>/dev/null | sed -E 's#https://github\.com/([^/]+/[^/]+)/.*#\1#' |
      sort | uniq -c | sort -rn | awk '{ print $2 }'
    find "$CODE_DIR" -maxdepth 6 -name .git -type d -prune 2>/dev/null | while IFS= read -r g; do
      git -C "${g%/.git}" remote get-url origin 2>/dev/null
    done | sed -nE 's#^(https://github\.com/|git@github\.com:)([^/]+/[^/]+)$#\2#p' | sed 's/\.git$//'
    cat "$REPOS_CACHE" 2>/dev/null
  } | awk -v owners="$(cut -f5 "$CACHE_DIR/issues.tsv" 2>/dev/null | cut -d/ -f4 | sort -u | tr '\n' ' ')" '
    # only the orgs your issues come from (no personal or third-party clones)
    BEGIN { n = split(tolower(owners), o, " "); for (i = 1; i <= n; i++) ok[o[i]] = 1 }
    { split(tolower($0), part, "/") } (part[1] in ok) && !seen[tolower($0)]++'
}

# Issues created here are added to the sidebar's list at once, and claude-issues keeps them
# for 15 minutes while GitHub's search catches up (like closed.tsv the other way round)
remember_created() { # <url> <title>
  local url=$1 title=$2 repo num row
  [[ $url =~ github\.com/[^/]+/([^/]+)/issues/([0-9]+) ]] || return
  repo=${BASH_REMATCH[1]} num=${BASH_REMATCH[2]}
  row=$(printf '%s\t%s\t0\t%s\t%s' "$repo" "$num" "${title//$'\t'/ }" "$url")
  printf '%s\t%s\n' "$(date +%s)" "$row" >>"$CACHE_DIR/created.tsv"
  {
    printf '%s\n' "$row"
    cat "$CACHE_DIR/issues.tsv" 2>/dev/null
  } >"$CACHE_DIR/issues.tsv.tmp" &&
    mv "$CACHE_DIR/issues.tsv.tmp" "$CACHE_DIR/issues.tsv"
  chmod 600 "$CACHE_DIR/issues.tsv"
  tmux set -g @claude_issue_selected "$url"
  local here
  here=$(dirname "$(readlink -f "$0")")
  "$here/claude-sidebar" refresh >/dev/null 2>&1
  # Refetch the list in the background (it keeps the new issue while search lags)
  (flock -n "$CACHE_DIR/issues.lock" "$here/claude-issues" && "$here/claude-sidebar" refresh) </dev/null >/dev/null 2>&1 &
}

new_issue() { # <window>
  local window=$1
  local ESC=$'\e'
  local RESET="${ESC}[0m" BOLD="${ESC}[1m" DIM="${ESC}[38;5;245m" KEY="${ESC}[38;5;215m" WARN="${ESC}[38;5;214m" SEL="${ESC}[48;5;238m"
  trap 'printf "\e[?25h"; stty echo 2>/dev/null' EXIT # (literal: locals are gone by then)
  mkdir -p "$CACHE_DIR"
  # A day-old (or missing) org listing is refreshed while you pick
  if [ ! -s "$REPOS_CACHE" ] || [ $(($(date +%s) - $(stat -c %Y "$REPOS_CACHE"))) -gt 86400 ]; then
    refresh_repo_list </dev/null >/dev/null 2>&1 &
  fi

  # 1. Repo: type to filter, ↑/↓ (or ctrl-n/p) to move, Enter to pick
  local all=() shown=() filter='' sel=0 key k repo
  mapfile -t all < <(repo_choices)
  stty -echo 2>/dev/null
  printf '%s' "${ESC}[?25l"
  while true; do
    # pick up the org listing once the background refresh lands
    [ ${#all[@]} -gt 0 ] || mapfile -t all < <(repo_choices)
    shown=()
    local r
    for r in "${all[@]}"; do [[ ${r,,} == *"${filter,,}"* ]] && shown+=("$r"); done
    [ "$sel" -lt ${#shown[@]} ] || sel=$((${#shown[@]} - 1))
    [ "$sel" -ge 0 ] || sel=0
    local rows out i first
    rows=$(($(tput lines) - 5))
    first=$((sel >= rows ? sel - rows + 1 : 0))
    out="${ESC}[H ${BOLD}New issue${RESET} ${DIM}— pick a repo${RESET}${ESC}[K"$'\n'"${ESC}[K"$'\n'
    out+=" ${KEY}›${RESET} ${filter}${DIM}▏ type to filter${RESET}${ESC}[K"$'\n'"${ESC}[K"$'\n'
    for ((i = first; i < first + rows; i++)); do
      if [ "$i" -lt ${#shown[@]} ]; then
        if [ "$i" = "$sel" ]; then
          out+="${SEL} ${KEY}▸${RESET}${SEL} ${shown[i]}${ESC}[K${RESET}"$'\n'
        else out+="   ${shown[i]}${ESC}[K"$'\n'; fi
      else
        out+="${ESC}[K"$'\n'
      fi
    done
    [ ${#shown[@]} -gt 0 ] || out+="${ESC}[4;1H   ${DIM}no repo matches${RESET}"
    printf '%s' "${ESC}[?2026h$out${ESC}[$(tput lines);1H ${KEY}↑/↓${DIM} move · ${KEY}⏎${DIM} pick · ${KEY}esc${DIM} cancel${RESET}${ESC}[K${ESC}[?2026l"

    IFS= read -rsn1 -d '' -t 1 key || continue
    while IFS= read -rsn1 -d '' -t 0.01 k; do key+=$k; done
    case $key in
    $'\e[A' | $'\eOA' | $'\x10') sel=$((sel - 1)) ;;
    $'\e[B' | $'\eOB' | $'\x0e') sel=$((sel + 1)) ;;
    $'\n' | $'\r') [ ${#shown[@]} -gt 0 ] && {
      repo=${shown[sel]}
      break
    } ;;
    $'\x7f' | $'\b') if [ -n "$filter" ]; then
      filter=${filter%?}
      sel=0
    else exit 0; fi ;;
    $'\e') exit 0 ;;
    $'\e'*) ;; # other special keys
    *) [[ $key == [[:print:]]* ]] && {
      filter+=$key
      sel=0
    } ;;
    esac
  done

  # 2. Title (readline line editing), 3. description in $EDITOR, 4. confirm
  local title='' body_file='' err='' url=''
  body_file=$(mktemp "${TMPDIR:-/tmp}/claude-issue-body.XXXXXX.md")
  chmod 600 "$body_file"
  stty echo 2>/dev/null
  printf '%s' "${ESC}[?25h${ESC}[2J${ESC}[H ${BOLD}New issue in ${repo}${RESET}"$'\n\n'
  while [ -z "${title// /}" ]; do
    IFS= read -r -e -p " Title: " title || exit 0
  done
  "${EDITOR:-nvim}" "$body_file"
  while true; do
    stty -echo 2>/dev/null
    printf '%s' "${ESC}[?25l${ESC}[2J${ESC}[H ${BOLD}New issue in ${repo}${RESET}"$'\n\n'" ${BOLD}${title}${RESET}"$'\n\n'
    if [ -s "$body_file" ]; then sed 's/^/ /' "$body_file" | head -n $(($(tput lines) - 8)); else printf ' %s(no description)%s\n' "$DIM" "$RESET"; fi
    printf '%s' "${ESC}[$(tput lines);1H ${KEY}y${DIM} create · ${KEY}e${DIM} edit description · ${KEY}n${DIM} cancel${RESET}"
    IFS= read -rsn1 key || exit 0
    case $key in
    y)
      printf '%s' "${ESC}[$(tput lines);1H${ESC}[K ${DIM}Creating…${RESET}"
      if url=$(gh issue create -R "$repo" --title "$title" --body-file "$body_file" 2>"$body_file.err"); then
        url=$(grep -o 'https://github\.com/[^ ]*/issues/[0-9]*' <<<"$url" | tail -1)
        rm -f "$body_file" "$body_file.err"
        remember_created "$url" "$title"
        # Show the new issue in the popup
        view "$url" "$window"
        exit 0
      fi
      err=$(head -1 "$body_file.err")
      printf '%s' "${ESC}[$(tput lines);1H${ESC}[K ${WARN}Could not create: ${err}${RESET}  ${DIM}(any key)${RESET}"
      IFS= read -rsn1 key
      ;;
    e)
      stty echo 2>/dev/null
      "${EDITOR:-nvim}" "$body_file"
      ;;
    n | $'\e' | q)
      rm -f "$body_file" "$body_file.err"
      exit 0
      ;;
    esac
  done
}

view() {
  local url=$1 window=$2
  local ESC=$'\e'
  local RESET="${ESC}[0m" DIM="${ESC}[38;5;245m" KEY="${ESC}[38;5;215m" WARN="${ESC}[38;5;214m"
  trap 'printf "\e[?25h"' EXIT # (literal: locals are gone by then)
  printf '%s' "${ESC}[?25l"

  local repo num width base title labels text=() lines=() shown_images='' top=0
  width=$(($(tput cols) - 2))

  # Load <url>: gh's rendering of the issue (metadata + markdown body), sized to the popup,
  # from the cache when the sidebar prefetched it; title and labels for the branch name
  load() {
    url=$1
    [[ $url =~ github\.com/([^/]+/[^/]+)/issues/([0-9]+) ]] || {
      text=("Not an issue url: $url")
      return
    }
    repo=${BASH_REMATCH[1]} num=${BASH_REMATCH[2]} top=0 title='' labels='' shown_images=''
    printf '%s' "${ESC}[2J${ESC}[H${DIM} Loading $repo#$num…$RESET"
    last_frame=
    fetch_issue "$repo" "$num" "$width" wait
    base=$(cache_base "$repo" "$num" "$width")
    if [ -s "$base.txt" ]; then
      mapfile -t text <"$base.txt"
      title=$(sed -n 1p "$base.meta")
      labels=$(sed -n 2p "$base.meta")
    else
      mapfile -t text <"$base.err"
    fi
    [ -n "$title" ] || title="issue $num"
    # Tell the sidebar which issue is open, and get the neighbours ready
    tmux set -g @claude_issue_selected "$url"
    "$(dirname "$(readlink -f "$0")")/claude-sidebar" refresh >/dev/null 2>&1
    local nb
    # (only those not cached yet; after ↑/↓ the one behind you is, so it is the next one
    # in the direction you are going; 9>&-: not holding this issue's lock while they run)
    for nb in "$(neighbour -1)" "$(neighbour 1)"; do
      [ -n "$nb" ] && "$0" prefetch "$nb" "$width" 9>&- </dev/null >/dev/null 2>&1 &
    done
  }

  # The issue before/after this one in the sidebar's list
  neighbour() { # <-1|1>
    awk -F'\t' -v u="$url" -v d="$1" '{ urls[NR] = $5; if ($5 == u) at = NR }
      END { if (at && urls[at + d] != "") print urls[at + d] }' "$CACHE_DIR/issues.tsv" 2>/dev/null
  }
  position() {
    awk -F'\t' -v u="$url" '$5 == u { at = NR } END { if (at) print at "/" NR }' "$CACHE_DIR/issues.tsv" 2>/dev/null
  }

  # text + the images, placed above gh's closing "View this issue on GitHub" line
  compose() {
    local state='done'
    [ -f "$base.images" ] || state=loading
    local have
    have="$state $(ls "$base".img[0-9]*.txt 2>/dev/null | wc -l)"
    [ "$have" = "$shown_images" ] && return
    shown_images=$have
    local i at=${#text[@]} n f
    for ((i = ${#text[@]} - 1; i >= 0; i--)); do
      [[ ${text[i]} == *"View this issue on GitHub"* ]] && {
        at=$i
        break
      }
    done
    local images=()
    for ((n = 1; n <= IMAGE_MAX; n++)); do
      f="$base.img$n.txt"
      [ -f "$f" ] || continue
      images+=("" "  ${DIM}▣ $(cat "$base.img$n.name" 2>/dev/null)${RESET}")
      while IFS= read -r i; do images+=("  $i"); done <"$f"
    done
    [ "$state" = loading ] && [ -s "$base.meta" ] && grep -qE '!\[[^]]*\]\(|<img ' <(tail -n +3 "$base.meta") &&
      images+=("" "  ${DIM}Loading images…${RESET}")
    [ ${#images[@]} -gt 0 ] && images+=("")
    lines=("${text[@]:0:at}" "${images[@]}" "${text[@]:at}")
  }

  load "$url"
  local message='' confirm=0 key k
  local last_frame=
  while true; do
    compose
    local rows body last out='' i
    rows=$(tput lines)
    body=$((rows - 2))
    last=$((${#lines[@]} - body))
    [ "$last" -ge 0 ] || last=0
    [ "$top" -le "$last" ] || top=$last
    [ "$top" -ge 0 ] || top=0
    for ((i = top; i < top + body; i++)); do
      out+=" ${lines[i]:-}$RESET${ESC}[K"$'\n'
    done
    local pos='' at
    [ ${#lines[@]} -gt "$body" ] && pos="  ${DIM}line $((top + 1))/${#lines[@]}"
    at=$(position)
    local vhint=
    [ "$(cat "$base.images" 2>/dev/null || echo 0)" -gt 0 ] && vhint="${KEY}v${DIM} images · "
    local footer=" ${KEY}↑/↓${DIM} issue ${at:-–} · ${vhint}${KEY}o${DIM} browser · ${KEY}s${DIM} copy link · ${KEY}c${DIM} Claude Code · ${KEY}x${DIM} close issue · ${KEY}⌫${DIM} back · ${KEY}j/k${DIM} scroll$pos"
    [ -n "$message" ] && footer=" ${WARN}${message}${RESET}"
    [ "$confirm" = 1 ] && footer=" ${WARN}Close $repo#$num?${RESET}  ${KEY}y${DIM} completed · ${KEY}n${DIM} not planned · ${KEY}esc${DIM} cancel"
    # Only when something changed: the loop wakes every second, and repainting an unchanged
    # popup made it (and the sidebar under it) flicker
    local frame="$out${ESC}[K"$'\n'"$footer$RESET${ESC}[K"
    if [ "$frame" != "$last_frame" ]; then
      printf '%s' "${ESC}[?2026h${ESC}[H$frame${ESC}[?2026l"
      last_frame=$frame
    fi

    # Wake every second, so images that finish loading appear without a key press
    IFS= read -rsn1 -d '' -t 1 key || continue
    while IFS= read -rsn1 -d '' -t 0.01 k; do key+=$k; done
    message= # shown until the next key

    if [ "$confirm" = 1 ]; then
      confirm=0
      case $key in
      y)
        close_issue "$repo" "$num" completed
        exit 0
        ;;
      n)
        close_issue "$repo" "$num" "not planned"
        exit 0
        ;;
      esac
      continue # anything else cancels
    fi
    case $key in
    $'\e[A' | $'\eOA' | $'\e[B' | $'\eOB')
      local next
      if [[ $key == *A ]]; then next=$(neighbour -1); else next=$(neighbour 1); fi
      if [ -n "$next" ]; then load "$next"; else message="No more issues that way"; fi
      ;;
    v)
      local count
      count=$(cat "$base.images" 2>/dev/null || echo 0)
      if [ "$count" -gt 0 ]; then
        tmux new-window -n issue-image "'$(readlink -f "$0")' images '$url' '$base' 1 '$window'"
        exit 0
      fi
      message="No images in this issue"
      ;;
    x) confirm=1 ;;
    j) top=$((top + 1)) ;;
    k) top=$((top - 1)) ;;
    ' ' | $'\e[6~') top=$((top + body - 1)) ;;
    b | $'\e[5~') top=$((top - body + 1)) ;;
    g) top=0 ;;
    G) top=$last ;;
    s)
      if copy_to_clipboard "https://github.com/$repo/issues/$num" 2>/dev/null; then
        message="Copied https://github.com/$repo/issues/$num"
      else
        message="Could not copy the link"
      fi
      ;;
    o)
      open_in_browser "https://github.com/$repo/issues/$num"
      exit 0
      ;;
    c) start_claude "$repo" "$num" "$title" "$labels" "https://github.com/$repo/issues/$num" "$window" && exit 0 ;;
    $'\x7f' | $'\b' | q | $'\e') exit 0 ;;
    esac
  done
}

[ "${BASH_SOURCE[0]}" = "$0" ] || return 0 # sourced: functions only

case ${1:-} in
view) view "$2" "$3" ;;
new) new_issue "$2" ;;
close-on-github) close_on_github "$2" "$3" "$4" "$5" ;;
open) open_popup "$2" "$3" ;;
images) images "$2" "$3" "$4" "$5" ;;
prefetch)
  [[ $2 =~ github\.com/([^/]+/[^/]+)/issues/([0-9]+) ]] || exit 1
  fetch_issue "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "$3" skip
  ;;
*)
  echo "usage: claude-issue view|open <issue-url> <window-id> | new <window-id> | prefetch <issue-url> <width> | images <issue-url> <base> <n> <window-id>" >&2
  exit 1
  ;;
esac
