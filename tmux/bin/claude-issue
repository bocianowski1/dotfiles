#!/usr/bin/env bash
# Issue view for the tmux Claude sidebar:
#   claude-issue view <issue-url> <window-id>   the popup (run inside tmux display-popup)
#   claude-issue prefetch <issue-url> <width>   cache the issue for a popup of that text width
#                                                (the sidebar runs this on hover/selection)
# Fetched issues are cached for the minutes in ~/.config/claude-sidebar/issue-ttl (default 15).
# Shows the issue (title, metadata, description) with gh's own rendering. Keys:
#   j/k ↓/↑ scroll · space/b page · g/G top/bottom
#   o        open in the browser (and close)
#   c        start Claude Code in a new pane of <window>, in the repo's local clone,
#            with a prompt to branch off and implement/fix the issue (and close)
#   x        close the issue on GitHub, after confirming: y completed · n not planned
#   ⌫ q Esc  close
# CLAUDE_ISSUE_DRYRUN=1 makes "c" print the pane command and prompt instead of running it,
# and "x" skip the GitHub call. CLAUDE_SIDEBAR_CACHE overrides ~/.cache/claude-sidebar.
set -uo pipefail
USER_LOGIN=torgermalling
CODE_DIR=~/code
CACHE_DIR=${CLAUDE_SIDEBAR_CACHE:-~/.cache/claude-sidebar}
PROMPTS=$CACHE_DIR/prompts
VIEW_CACHE=$CACHE_DIR/issue-view
TTL_FILE=~/.config/claude-sidebar/issue-ttl

GH_TOKEN=$(gh auth token --user "$USER_LOGIN")
export GH_TOKEN GH_PAGER=cat

# Local clone of owner/repo under CODE_DIR: real clones only (a worktree's .git is a file),
# matched on the origin remote, preferring the folder named after the repo
find_clone() {
  local want=${1,,} name=${1##*/} best= dir remote
  while IFS= read -r dir; do
    remote=$(git -C "$dir" remote get-url origin 2>/dev/null) || continue
    remote=${remote,,}
    remote=${remote%.git}
    [[ $remote == */"$want" || $remote == *:"$want" ]] || continue
    if [ "${dir##*/}" = "$name" ]; then
      echo "$dir"
      return
    fi
    [ -n "$best" ] || best=$dir
  done < <(find "$CODE_DIR" -maxdepth 6 -name .git -type d -prune 2>/dev/null | sed 's|/\.git$||' | sort)
  [ -n "$best" ] && echo "$best"
}

# A pane of <window> to split: the one you were using, never the sidebar
work_pane() {
  tmux list-panes -t "$1" -F '#{pane_active} #{pane_last} #{pane_id} #{@claude_sidebar}' |
    awk '$4 != "1" { score = $1 * 2 + $2; if (!found || score > best) { best = score; id = $3; found = 1 } }
         END { print id }'
}

branch_name() { # <number> <title> <labels>
  local type=feat slug
  [[ ,${3,,}, == *,bug,* ]] && type=fix
  slug=$(printf '%s' "${2,,}" | sed 's/æ/ae/g; s/ø/o/g; s/å/a/g' | tr -c 'a-z0-9' '-' | tr -s '-' | sed 's/^-//; s/-$//')
  slug=${slug:0:40}
  echo "$type/$1-${slug%-}"
}

start_claude() { # <owner/repo> <number> <title> <labels> <url> <window>
  local repo=$1 num=$2 title=$3 labels=$4 url=$5 window=$6 dir pane branch prompt_file
  dir=$(find_clone "$repo") || true
  if [ -z "$dir" ]; then
    message="No local clone of $repo under ${CODE_DIR/#$HOME/\~}"
    return 1
  fi
  branch=$(branch_name "$num" "$title" "$labels")
  mkdir -p "$PROMPTS"
  prompt_file="$PROMPTS/${repo//\//-}-$num.md"
  cat >"$prompt_file" <<EOF
Work on GitHub issue $repo#$num: "$title"
$url

1. Read the full issue, including comments: \`gh issue view $num -R $repo --comments\`
2. Check that the working tree is clean (stop and ask me if it is not), update the default branch, and create a new branch from it named \`$branch\`.
3. Investigate the relevant code. For a bug: reproduce it and find the root cause. For a feature: work out where it fits and what has to change. Explain what you found and give a short implementation plan, then wait for my go-ahead before changing code.
4. Implement it following this repo's conventions, with tests that cover the change, and run the tests.
5. Do not push or open a pull request until I ask.
EOF
  pane=$(work_pane "$window")
  # Claude starts with the prompt; when it exits, the pane stays as a shell in the repo
  local cmd=(tmux split-window -h -t "$pane" -c "$dir" -- bash -c 'claude "$(cat "$1")"; exec bash' _ "$prompt_file")
  if [ "${CLAUDE_ISSUE_DRYRUN:-}" = 1 ]; then
    printf '%q ' "${cmd[@]}" >"$PROMPTS/dryrun.txt"
    return 0
  fi
  "${cmd[@]}"
}

ttl_minutes() {
  local m
  m=$(cat "$TTL_FILE" 2>/dev/null)
  [[ $m =~ ^[0-9]+$ ]] || m=15
  echo "$m"
}

# Cache files for an issue rendered at a text width: <base>.txt (gh's rendering) and
# <base>.meta (title, then labels). gh formats for a width, so the width is part of the key.
cache_base() { echo "$VIEW_CACHE/${1//\//_}_$2_w$3"; } # <owner/repo> <number> <width>

cache_fresh() { # <base>
  [ -s "$1.txt" ] && [ -f "$1.meta" ] || return 1
  [ $(($(date +%s) - $(stat -c %Y "$1.txt"))) -lt $(($(ttl_minutes) * 60)) ]
}

# Fetch an issue into the cache unless it is fresh. "wait" blocks on a fetch already
# running for it (the popup); "skip" leaves that one to finish on its own (prefetch).
fetch_issue() { # <owner/repo> <number> <width> <wait|skip>
  local repo=$1 num=$2 width=$3 base
  base=$(cache_base "$repo" "$num" "$width")
  mkdir -p "$VIEW_CACHE"
  exec 9>"$base.lock"
  if [ "$4" = skip ]; then flock -n 9 || return 0; else flock 9; fi
  cache_fresh "$base" && return 0
  local text meta
  GH_FORCE_TTY=$width gh issue view "$num" -R "$repo" >"$base.txt.tmp" 2>&1 &
  text=$!
  gh issue view "$num" -R "$repo" --json title,labels --jq '.title, ([.labels[].name] | join(","))' >"$base.meta.tmp" 2>/dev/null &
  meta=$!
  if wait "$text" && wait "$meta"; then
    chmod 600 "$base.txt.tmp" "$base.meta.tmp"
    mv "$base.txt.tmp" "$base.txt"
    mv "$base.meta.tmp" "$base.meta"
    rm -f "$base.err"
  else
    # Never cache a failure: keep gh's message for the popup to show
    mv "$base.txt.tmp" "$base.err"
    rm -f "$base.meta.tmp"
  fi
}

drop_cached() { rm -f "$VIEW_CACHE/${1//\//_}_$2_w"*; } # <owner/repo> <number>

open_in_browser() {
  if command -v explorer.exe >/dev/null; then explorer.exe "$1" >/dev/null 2>&1
  elif command -v xdg-open >/dev/null; then xdg-open "$1" >/dev/null 2>&1 &
  fi
  # The sidebar refetches its issues when you come back to the terminal
  tmux set -g @claude_issues_dirty 1
}

# Close the issue on GitHub, drop it from the sidebar's cache straight away, and remember it
# for claude-issues, since GitHub's search can list a closed issue as open for a while
close_issue() { # <owner/repo> <number> <completed|not planned>
  local repo=$1 num=$2 reason=$3 url="https://github.com/$1/issues/$2" err
  if [ "${CLAUDE_ISSUE_DRYRUN:-}" != 1 ]; then
    if ! err=$(gh issue close "$num" -R "$repo" --reason "$reason" 2>&1 >/dev/null); then
      message="Could not close $repo#$num: ${err%%$'\n'*}"
      return 1
    fi
  fi
  printf '%s\t%s\n' "$url" "$(date +%s)" >>"$CACHE_DIR/closed.tsv"
  drop_cached "$repo" "$num"
  if [ -f "$CACHE_DIR/issues.tsv" ]; then
    awk -F'\t' -v u="$url" '$5 != u' "$CACHE_DIR/issues.tsv" >"$CACHE_DIR/issues.tsv.tmp" &&
      mv "$CACHE_DIR/issues.tsv.tmp" "$CACHE_DIR/issues.tsv"
  fi
  "$(dirname "$(readlink -f "$0")")/claude-sidebar" refresh >/dev/null 2>&1
}

view() {
  local url=$1 window=$2
  [[ $url =~ github\.com/([^/]+/[^/]+)/issues/([0-9]+) ]] || { echo "Not an issue url: $url"; read -rsn1; exit 1; }
  local repo=${BASH_REMATCH[1]} num=${BASH_REMATCH[2]}
  local ESC=$'\e'
  local RESET="$ESC[0m" DIM="$ESC[38;5;245m" KEY="$ESC[38;5;215m" WARN="$ESC[38;5;214m"
  trap 'printf "%s" "$ESC[?25h"' EXIT
  printf '%s' "$ESC[?25l$ESC[2J$ESC[H${DIM}Loading $repo#$num…$RESET"

  # gh's terminal rendering of the issue (metadata + markdown body), sized to the popup,
  # from the cache when the sidebar prefetched it; title and labels for the branch name
  local width base lines=() title labels
  width=$(($(tput cols) - 2))
  fetch_issue "$repo" "$num" "$width" wait
  base=$(cache_base "$repo" "$num" "$width")
  if [ -s "$base.txt" ]; then
    mapfile -t lines <"$base.txt"
    title=$(sed -n 1p "$base.meta")
    labels=$(sed -n 2p "$base.meta")
  else
    mapfile -t lines <"$base.err"
  fi
  [ -n "$title" ] || title="issue $num"

  local top=0 message= confirm=0 key k
  while true; do
    local rows body last out= i
    rows=$(tput lines)
    body=$((rows - 2))
    last=$((${#lines[@]} - body))
    [ "$last" -ge 0 ] || last=0
    [ "$top" -le "$last" ] || top=$last
    [ "$top" -ge 0 ] || top=0
    for ((i = top; i < top + body; i++)); do
      out+=" ${lines[i]:-}$RESET$ESC[K"$'\n'
    done
    local pos=
    [ ${#lines[@]} -gt "$body" ] && pos="  $((top + 1))–$((top + body > ${#lines[@]} ? ${#lines[@]} : top + body))/${#lines[@]}"
    local footer=" ${KEY}o${DIM} open in browser · ${KEY}c${DIM} Claude Code · ${KEY}x${DIM} close issue · ${KEY}⌫${DIM} back · ${KEY}j/k${DIM} scroll$pos"
    [ -n "$message" ] && footer=" ${WARN}${message}${RESET}"
    [ "$confirm" = 1 ] && footer=" ${WARN}Close $repo#$num?${RESET}  ${KEY}y${DIM} completed · ${KEY}n${DIM} not planned · ${KEY}esc${DIM} cancel"
    printf '%s' "$ESC[H$out$ESC[K"$'\n'"$footer$RESET$ESC[K"

    IFS= read -rsn1 -d '' -t 1 key || continue
    while IFS= read -rsn1 -d '' -t 0.01 k; do key+=$k; done
    message= # shown until the next key

    if [ "$confirm" = 1 ]; then
      confirm=0
      case $key in
        y) close_issue "$repo" "$num" completed && exit 0 ;;
        n) close_issue "$repo" "$num" "not planned" && exit 0 ;;
      esac
      continue # anything else cancels
    fi
    case $key in
      x) confirm=1 ;;
      j | $'\e[B' | $'\eOB') top=$((top + 1)) ;;
      k | $'\e[A' | $'\eOA') top=$((top - 1)) ;;
      ' ' | $'\e[6~') top=$((top + body - 1)) ;;
      b | $'\e[5~') top=$((top - body + 1)) ;;
      g) top=0 ;;
      G) top=$last ;;
      o)
        open_in_browser "https://github.com/$repo/issues/$num"
        exit 0
        ;;
      c) start_claude "$repo" "$num" "$title" "$labels" "https://github.com/$repo/issues/$num" "$window" && exit 0 ;;
      $'\x7f' | $'\b' | q | $'\e') exit 0 ;;
    esac
  done
}

case ${1:-} in
view) view "$2" "$3" ;;
prefetch)
  [[ $2 =~ github\.com/([^/]+/[^/]+)/issues/([0-9]+) ]] || exit 1
  fetch_issue "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "$3" skip
  ;;
*)
  echo "usage: claude-issue view <issue-url> <window-id> | prefetch <issue-url> <width>" >&2
  exit 1
  ;;
esac
