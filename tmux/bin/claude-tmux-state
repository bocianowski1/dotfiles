#!/usr/bin/env bash
# Called by Claude Code hooks: claude-tmux-state running|attention|idle|clear
# Tags the tmux pane Claude runs in, and rolls the most urgent state up to its window.
# Going from running (or waiting on you) to idle means Claude just answered: @claude_replied
# keeps when, for the sidebar's "answered recently" dot.
[ -n "$TMUX_PANE" ] || exit 0
state=$1
{
  if [ "$state" = clear ]; then
    tmux set -pu -t "$TMUX_PANE" @claude_state
    tmux set -pu -t "$TMUX_PANE" @claude_replied
  else
    if [ "$state" = idle ]; then
      case $(tmux show -pv -t "$TMUX_PANE" @claude_state 2>/dev/null) in
      running | attention) tmux set -p -t "$TMUX_PANE" @claude_replied "$EPOCHSECONDS" ;;
      esac
    fi
    tmux set -p -t "$TMUX_PANE" @claude_state "$state"
  fi

  states=$(tmux list-panes -t "$TMUX_PANE" -F '#{@claude_state}')
  case $states in
  *attention*) win=attention ;;
  *running*) win=running ;;
  *idle*) win=idle ;;
  *) win= ;;
  esac
  if [ -n "$win" ]; then
    tmux set -w -t "$TMUX_PANE" @claude_win "$win"
  else
    tmux set -wu -t "$TMUX_PANE" @claude_win
  fi
  tmux refresh-client -S
  "$(dirname "$(readlink -f "$0")")/claude-sidebar" refresh
} >/dev/null 2>&1
exit 0
