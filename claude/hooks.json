{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/tmux/bin/claude-tmux-state idle"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/tmux/bin/claude-tmux-state running"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/tmux/bin/claude-tmux-state attention"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/tmux/bin/claude-tmux-state running"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude/bin/agent-attention Claude 'Claude is waiting for approval or input.'"
          },
          {
            "type": "command",
            "command": "$HOME/dotfiles/tmux/bin/claude-tmux-state attention"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/tmux/bin/claude-tmux-state attention"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/tmux/bin/claude-tmux-state idle"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/tmux/bin/claude-tmux-state clear"
          }
        ]
      }
    ]
  }
}
