#!/usr/bin/env python3
"""Claude Code status line: prints user@host:cwd, and records usage for the tmux sidebar.

Claude Code runs this with a JSON description of the session on stdin. Besides printing the
status line, it writes ~/.cache/claude-sidebar/usage/<tmux pane>.tsv (one key<TAB>value per
line) with the session's context use and the account's 5-hour and weekly rate limits, for
claude-sidebar to draw. The last raw input is kept in last-input.json for reference.
"""
import json
import os
import socket
import sys
import time
from pathlib import Path

USAGE_DIR = Path.home() / ".cache/claude-sidebar/usage"


def pick(data, *path):
    for key in path:
        if not isinstance(data, dict) or key not in data:
            return None
        data = data[key]
    return data


def record(data: dict) -> None:
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(USAGE_DIR, 0o700)
    fields = {
        "updated": int(time.time()),
        "session": pick(data, "session_id"),
        "model": pick(data, "model", "display_name"),
        "ctx_pct": pick(data, "context_window", "used_percentage"),
        "five_hour_pct": pick(data, "rate_limits", "five_hour", "used_percentage"),
        "five_hour_resets": pick(data, "rate_limits", "five_hour", "resets_at"),
        "seven_day_pct": pick(data, "rate_limits", "seven_day", "used_percentage"),
        "seven_day_resets": pick(data, "rate_limits", "seven_day", "resets_at"),
    }
    pane = os.environ.get("TMUX_PANE", "").lstrip("%") or "none"
    text = "".join(f"{k}\t{'' if v is None else v}\n" for k, v in fields.items())
    for name, content in ((f"{pane}.tsv", text), ("last-input.json", json.dumps(data, indent=2))):
        tmp = USAGE_DIR / f".{name}.tmp"
        tmp.write_text(content)
        os.chmod(tmp, 0o600)
        tmp.replace(USAGE_DIR / name)


def main() -> None:
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = {}
    try:
        record(data)
    except OSError:
        pass  # the status line itself must always print
    cwd = pick(data, "workspace", "current_dir") or os.getcwd()
    chroot = os.environ.get("debian_chroot", "")
    user = os.environ.get("USER") or os.getlogin()
    host = socket.gethostname().split(".")[0]
    prefix = f"({chroot})" if chroot else ""
    print(f"{prefix}\033[01;32m{user}@{host}\033[00m:\033[01;34m{cwd}\033[00m")


if __name__ == "__main__":
    main()
